      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="12">
      <Properties>
        <string name="Name">BeltService</string>
        <string name="Source"><![CDATA[--[[
	BeltService
	The shared conveyor belt in the middle of the map. Spawns rarity-weighted
	influencers at BeltStart, slides them to BeltEnd, and despawns whoever
	nobody grabbed. Claiming is handled by InfluencerService's ProximityPrompt
	(first valid grab wins).
]]

local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Players = game:GetService("Players")

local Constants = require(RS.Modules.Constants)
local InfluencerService = require(SSS.InfluencerService)
local Notify = require(SSS.Notify)

local BeltService = {}

local rng = Random.new()
local spawnTimer = 0

function BeltService.Init()
	RunService.Heartbeat:Connect(function(dt)
		BeltService.Step(dt)
	end)
end

function BeltService.Step(dt)
	local cfg = Constants.BELT

	-- move everything on the belt
	for _, rec in ipairs(InfluencerService.GetAllOnBelt()) do
		local x = (rec.BeltX or cfg.StartX) + cfg.Speed * dt
		if x >= cfg.EndX then
			InfluencerService.Destroy(rec)
		else
			InfluencerService.SetBeltPosition(rec, x)
		end
	end

	-- spawn new ones
	spawnTimer += dt
	if spawnTimer >= cfg.SpawnInterval then
		spawnTimer = 0
		if InfluencerService.CountOnBelt() < cfg.MaxOnBelt then
			local rarityIdx = Constants.RollRarity(rng)
			local rec = InfluencerService.Spawn(rarityIdx)
			if rarityIdx >= 4 then
				-- Epic / Legendary: let the whole server know
				local rarity = Constants.RARITIES[rarityIdx]
				for _, player in ipairs(Players:GetPlayers()) do
					Notify(player, rarity.Name:upper() .. " " .. rec.Name .. " just hit the belt!", "info")
				end
			end
		end
	end
end

return BeltService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="13">
      <Properties>
        <string name="Name">DefenseService</string>
        <string name="Source"><![CDATA[--[[
	DefenseService
	One Front Desk Worker per plot. When someone grabs an influencer off that
	plot's rack, the worker chases the thief ANYWHERE on the map (owner online
	or not). On touch: the influencer goes back to its original rack slot and
	the thief is knocked down (PlatformStand) and stunned for a moment.

	Worker speed = Constants.EQUIPMENT.DeskSpeed.Values[owner's DeskSpeed level]

	States: Idle -> Chase -> Return -> Idle
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local InfluencerService = require(SSS.InfluencerService)
local Notify = require(SSS.Notify)

local DefenseService = {}

local workers = {} -- [plotId] = worker record

local HEAD_OFFSET = CFrame.new(0, 2.6, 0)
local BODY_Y = 2.4

-- ----------------------------------------------------------------------
local function buildWorker(plot)
	local spawnPart = plot.Model:FindFirstChild("DeskSpawn")
	local home = spawnPart and spawnPart.Position or plot.Model:GetPivot().Position
	home = Vector3.new(home.X, BODY_Y, home.Z)

	local model = Instance.new("Model")
	model.Name = "FrontDeskWorker"

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(2, 4, 1)
	body.Anchored = true
	body.CanCollide = false
	body.Material = Enum.Material.SmoothPlastic
	body.Color = Color3.fromRGB(35, 35, 40)
	body.Parent = model

	local shirt = Instance.new("Part")
	shirt.Name = "StaffShirt"
	shirt.Size = Vector3.new(2.05, 1.6, 1.05)
	shirt.Anchored = true
	shirt.CanCollide = false
	shirt.Material = Enum.Material.SmoothPlastic
	shirt.Color = Color3.fromRGB(230, 60, 60)
	shirt.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.4, 1.4, 1.4)
	head.Anchored = true
	head.CanCollide = false
	head.Material = Enum.Material.SmoothPlastic
	head.Color = Color3.fromRGB(255, 213, 170)
	head.Parent = model

	local tag = Instance.new("BillboardGui")
	tag.Name = "Tag"
	tag.Size = UDim2.new(0, 140, 0, 26)
	tag.StudsOffset = Vector3.new(0, 1.6, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 80
	tag.Parent = head

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = "FRONT DESK"
	label.Parent = tag

	model.PrimaryPart = body
	model.Parent = plot.Model

	local w = {
		Plot = plot,
		Model = model,
		Body = body,
		Shirt = shirt,
		Head = head,
		Label = label,
		Home = home,
		Pos = home,
		State = "Idle",
		Thefts = {}, -- list of { Rec = rec, ThiefUserId = id }
	}
	workers[plot.Id] = w
	return w
end

local function place(w, pos, lookAt)
	w.Pos = pos
	local cf
	if lookAt and (lookAt - pos).Magnitude > 0.05 then
		cf = CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z))
	else
		cf = CFrame.new(pos) * (w.Body.CFrame - w.Body.CFrame.Position)
	end
	w.Body.CFrame = cf
	w.Shirt.CFrame = cf * CFrame.new(0, 0.9, 0)
	w.Head.CFrame = cf * HEAD_OFFSET
end

local function deskSpeed(plot)
	local owner = PlotService.GetOwnerPlayer(plot)
	local profile = owner and PlayerDataService.GetProfile(owner.UserId)
	local level = profile and profile.Equipment.DeskSpeed or 1
	return Constants.EQUIPMENT.DeskSpeed.Values[level] or Constants.EQUIPMENT.DeskSpeed.Values[1]
end

local function setLabel(w, text, color)
	w.Label.Text = text
	w.Label.TextColor3 = color or Color3.new(1, 1, 1)
end

-- ----------------------------------------------------------------------
-- Stun / knockdown
-- ----------------------------------------------------------------------
local function knockDown(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then
		return
	end
	player:SetAttribute("Stunned", true)
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.PlatformStand = true
	-- little shove so it reads as a tackle
	hrp.AssemblyLinearVelocity = hrp.CFrame.LookVector * -25 + Vector3.new(0, 18, 0)

	task.delay(Constants.DEFENSE.StunSeconds, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid.WalkSpeed = Constants.NORMAL_WALKSPEED
			humanoid.JumpPower = 50
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		player:SetAttribute("Stunned", false)
	end)
end

-- ----------------------------------------------------------------------
-- Theft hooks (called from InfluencerService)
-- ----------------------------------------------------------------------
local function onTheftStarted(rec, thief, victimPlot)
	local w = workers[victimPlot.Id]
	if not w then
		return
	end
	table.insert(w.Thefts, { Rec = rec, ThiefUserId = thief.UserId })
	w.State = "Chase"
	setLabel(w, "STOP! THIEF!", Color3.fromRGB(255, 90, 90))
end

local function onTheftEnded(rec, victimPlot)
	local w = workers[victimPlot.Id]
	if not w then
		return
	end
	for i = #w.Thefts, 1, -1 do
		if w.Thefts[i].Rec == rec then
			table.remove(w.Thefts, i)
		end
	end
	if #w.Thefts == 0 and w.State == "Chase" then
		w.State = "Return"
		setLabel(w, "FRONT DESK")
	end
end

-- ----------------------------------------------------------------------
-- Heartbeat
-- ----------------------------------------------------------------------
local function currentTarget(w)
	-- drop stale entries, return first valid theft
	for i = #w.Thefts, 1, -1 do
		local t = w.Thefts[i]
		local stillStolen = t.Rec.Model and t.Rec.State == "Carried" and t.Rec.CarrierUserId == t.ThiefUserId
		if not stillStolen then
			table.remove(w.Thefts, i)
		end
	end
	return w.Thefts[1]
end

local function step(dt)
	for _, w in pairs(workers) do
		if w.State == "Chase" then
			local t = currentTarget(w)
			if not t then
				w.State = "Return"
				setLabel(w, "FRONT DESK")
			else
				local thief = Players:GetPlayerByUserId(t.ThiefUserId)
				local character = thief and thief.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local target = Vector3.new(hrp.Position.X, BODY_Y, hrp.Position.Z)
					local delta = target - w.Pos
					local dist = delta.Magnitude
					local speed = deskSpeed(w.Plot)
					local stepVec = dist > 0 and delta.Unit * math.min(speed * dt, dist) or Vector3.zero
					place(w, w.Pos + stepVec, target)

					if (target - w.Pos).Magnitude <= Constants.DEFENSE.CatchRadius then
						-- CAUGHT
						local rec = t.Rec
						InfluencerService.ReturnToOrigin(rec) -- fires onTheftEnded
						knockDown(thief)
						Notify(thief, "The Front Desk caught you! You dropped " .. rec.Name .. ".", "fail")
						local owner = PlotService.GetOwnerPlayer(w.Plot)
						if owner then
							Notify(owner, "Your Front Desk caught " .. thief.DisplayName .. " and saved " .. rec.Name .. "!", "success")
						end
					end
				end
			end
		elseif w.State == "Return" then
			local delta = w.Home - w.Pos
			local dist = delta.Magnitude
			if dist < 0.5 then
				w.State = "Idle"
				place(w, w.Home, w.Home + Vector3.new(0, 0, 0))
			else
				local stepVec = delta.Unit * math.min(Constants.DEFENSE.ReturnHomeSpeed * dt, dist)
				place(w, w.Pos + stepVec, w.Home)
			end
		end
	end
end

-- ----------------------------------------------------------------------
function DefenseService.Init()
	for _, plot in pairs(PlotService.GetAllPlots()) do
		local w = buildWorker(plot)
		-- face toward the belt while idle
		place(w, w.Home, Vector3.new(0, BODY_Y, 0))
	end
	InfluencerService.OnTheftStarted = onTheftStarted
	InfluencerService.OnTheftEnded = onTheftEnded
	RunService.Heartbeat:Connect(step)
end

-- Called when a plot is released (owner left)
function DefenseService.ResetPlot(plot)
	local w = workers[plot.Id]
	if not w then
		return
	end
	w.Thefts = {}
	w.State = "Idle"
	setLabel(w, "FRONT DESK")
	place(w, w.Home, Vector3.new(0, BODY_Y, 0))
end

return DefenseService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="14">
      <Properties>
        <string name="Name">EconomyService</string>
        <string name="Source"><![CDATA[--[[
	EconomyService
	- Pays every plot owner once per second for the influencers on their rack.
	- Owns active boosters (timed buffs) and all multiplier math.

	income/sec = sum(placed influencer income)
	             * clothing multiplier   (1 + sum of equipped clothing bonuses)
	             * rebirth multiplier    (Constants.RebirthMultiplier)
	             * active Income boosters
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)

local EconomyService = {}

local activeBoosters = {} -- [userId] = { [boosterId] = expiresAt (os.time) }

-- ----------------------------------------------------------------------
-- Multipliers
-- ----------------------------------------------------------------------
function EconomyService.ClothingMultiplier(profile)
	local bonus = 0
	for _, id in pairs(profile.Equipped) do
		local item = Constants.GetClothing(id)
		if item and profile.OwnedClothing[id] then
			bonus += item.Bonus
		end
	end
	return 1 + bonus
end

function EconomyService.BoosterMultiplier(userId, effect)
	local mult = 1
	local list = activeBoosters[userId]
	if not list then
		return mult
	end
	local now = os.time()
	for id, expires in pairs(list) do
		if expires > now then
			local b = Constants.GetBooster(id)
			if b and b.Effect == effect then
				mult *= b.Multiplier
			end
		end
	end
	return mult
end

function EconomyService.IncomeMultiplier(player)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return 1
	end
	return EconomyService.ClothingMultiplier(profile)
		* Constants.RebirthMultiplier(profile.Rebirths)
		* EconomyService.BoosterMultiplier(player.UserId, "Income")
end

function EconomyService.BaseIncome(plot)
	local total = 0
	for _, rec in pairs(plot.Slots) do
		if rec and rec.State == "Placed" then
			total += rec.Income
		end
	end
	return total
end

-- ----------------------------------------------------------------------
-- Boosters
-- ----------------------------------------------------------------------
local function syncBoosterAttr(player)
	local list = activeBoosters[player.UserId] or {}
	local out = {}
	local now = os.time()
	for id, expires in pairs(list) do
		if expires > now then
			out[id] = expires
		end
	end
	player:SetAttribute("Boosters", HttpService:JSONEncode(out))
end

function EconomyService.ActivateBooster(player, booster)
	activeBoosters[player.UserId] = activeBoosters[player.UserId] or {}
	local now = os.time()
	local current = activeBoosters[player.UserId][booster.Id]
	-- buying again while active refreshes (does not stack duration past one full timer from now)
	local base = (current and current > now) and current or now
	activeBoosters[player.UserId][booster.Id] = math.min(base + booster.Duration, now + booster.Duration * 2)
	syncBoosterAttr(player)
end

function EconomyService.ClearPlayer(player)
	activeBoosters[player.UserId] = nil
end

-- ----------------------------------------------------------------------
-- Tick
-- ----------------------------------------------------------------------
function EconomyService.Init()
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for _, player in ipairs(Players:GetPlayers()) do
				local plot = PlotService.GetPlotByOwner(player.UserId)
				if plot then
					local base = EconomyService.BaseIncome(plot)
					local mult = EconomyService.IncomeMultiplier(player)
					local perSec = base * mult
					if perSec > 0 then
						PlayerDataService.AddCash(player, perSec)
					end
					player:SetAttribute("IncomePerSec", perSec)
					player:SetAttribute("IncomeMultiplier", mult)
				end

				-- expire boosters
				local list = activeBoosters[player.UserId]
				if list then
					local changed = false
					for id, expires in pairs(list) do
						if expires <= now then
							list[id] = nil
							changed = true
						end
					end
					if changed then
						syncBoosterAttr(player)
					end
				end
			end
		end
	end)
end

return EconomyService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">InfluencerService</string>
        <string name="Source"><![CDATA[--[[
	InfluencerService
	Owns every influencer character in the world and its lifecycle:

	  OnBelt  -> riding the shared belt (claimable by anyone)
	  Carried -> held over a player's head on the way to a rack
	  Placed  -> sitting on a rack slot, earning Cash for the plot owner
	  Dropped -> lying on the ground, claimable by anyone, despawns after a while

	Stealing: grabbing a Placed influencer in someone else's gym makes it Carried
	with OriginPlotId/OriginSlot remembered. If the thief is caught (or dies) it
	returns to its origin slot; if the thief reaches their own rack it becomes theirs.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local Notify = require(SSS.Notify)

local InfluencerService = {}

-- Callbacks set by DefenseService
InfluencerService.OnTheftStarted = nil -- function(rec, thiefPlayer, victimPlot)
InfluencerService.OnTheftEnded = nil -- function(rec, victimPlot)

local records = {} -- [model] = rec
local carriedBy = {} -- [userId] = rec
local rackTouchDebounce = {} -- [userId] = os.clock()
local folder = nil
local rng = Random.new()

local HEAD_OFFSET = CFrame.new(0, 2.6, 0)
local CARRY_OFFSET = CFrame.new(0, 5.4, 0)
local DROP_Y = 2.2

-- ----------------------------------------------------------------------
-- Model construction
-- ----------------------------------------------------------------------
local function buildModel(rec)
	local rarity = Constants.RARITIES[rec.Rarity]

	local model = Instance.new("Model")
	model.Name = rec.Name

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(2, 4, 1)
	body.Anchored = true
	body.CanCollide = false
	body.Material = Enum.Material.SmoothPlastic
	body.Color = rarity.Color
	body.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.4, 1.4, 1.4)
	head.Anchored = true
	head.CanCollide = false
	head.Material = Enum.Material.SmoothPlastic
	head.Color = Color3.fromRGB(255, 213, 170)
	head.Parent = model

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.new(0, 160, 0, 44)
	tag.StudsOffset = Vector3.new(0, 1.6, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 90
	tag.Parent = head

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = rec.Name
	nameLabel.Parent = tag

	local rarityLabel = Instance.new("TextLabel")
	rarityLabel.Name = "RarityLabel"
	rarityLabel.Size = UDim2.new(1, 0, 0.4, 0)
	rarityLabel.Position = UDim2.new(0, 0, 0.6, 0)
	rarityLabel.BackgroundTransparency = 1
	rarityLabel.Font = Enum.Font.GothamBold
	rarityLabel.TextScaled = true
	rarityLabel.TextColor3 = rarity.Color
	rarityLabel.TextStrokeTransparency = 0.3
	rarityLabel.Text = rarity.Name .. "  +$" .. Constants.FormatNumber(rec.Income) .. "/s"
	rarityLabel.Parent = tag

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = "Grab"
	prompt.ObjectText = rec.Name
	prompt.HoldDuration = Constants.BELT.ClaimHold
	prompt.MaxActivationDistance = Constants.BELT.ClaimDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = body

	model.PrimaryPart = body
	model:SetAttribute("Rarity", rec.Rarity)
	model:SetAttribute("Income", rec.Income)
	model:SetAttribute("State", rec.State)
	model.Parent = folder

	rec.Model = model
	rec.Body = body
	rec.Head = head
	rec.Prompt = prompt
	records[model] = rec

	prompt.Triggered:Connect(function(player)
		InfluencerService.OnGrab(player, rec)
	end)
end

local function setState(rec, state)
	rec.State = state
	if rec.Model then
		rec.Model:SetAttribute("State", state)
	end
end

local function setCFrame(rec, cf)
	rec.Body.CFrame = cf
	rec.Head.CFrame = cf * HEAD_OFFSET
end

-- ----------------------------------------------------------------------
-- Profile helpers (persist placed influencers)
-- ----------------------------------------------------------------------
local function removeFromProfile(player, slot)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return
	end
	for i = #profile.Placed, 1, -1 do
		if profile.Placed[i].Slot == slot then
			table.remove(profile.Placed, i)
		end
	end
end

local function addToProfile(player, rec)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return
	end
	removeFromProfile(player, rec.Slot)
	table.insert(profile.Placed, { Rarity = rec.Rarity, Name = rec.Name, Slot = rec.Slot })
end

local function refreshRackAttr(plot)
	local owner = PlotService.GetOwnerPlayer(plot)
	if owner then
		owner:SetAttribute("RackUsed", PlotService.CountPlaced(plot.Id))
		owner:SetAttribute("RackSlots", plot.Unlocked)
	end
end

-- ----------------------------------------------------------------------
-- Carry helpers
-- ----------------------------------------------------------------------
local function setWalkSpeed(player, speed)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and not player:GetAttribute("Stunned") then
		humanoid.WalkSpeed = speed
	end
end

local function startCarry(player, rec)
	setWalkSpeed(player, Constants.CARRY_WALKSPEED)
	setState(rec, "Carried")
	rec.CarrierUserId = player.UserId
	carriedBy[player.UserId] = rec
	rec.Prompt.Enabled = false
	player:SetAttribute("Carrying", rec.Name)
end

local function endCarry(rec)
	local uid = rec.CarrierUserId
	if uid then
		carriedBy[uid] = nil
		local player = Players:GetPlayerByUserId(uid)
		if player then
			player:SetAttribute("Carrying", "")
			setWalkSpeed(player, Constants.NORMAL_WALKSPEED)
		end
	end
	rec.CarrierUserId = nil
end

local function placeAt(rec, plot, slot)
	local slotPart = PlotService.GetSlotPart(plot.Id, slot)
	setState(rec, "Placed")
	rec.PlotId = plot.Id
	rec.Slot = slot
	plot.Slots[slot] = rec
	rec.Prompt.Enabled = true
	if slotPart then
		local top = slotPart.Position.Y + slotPart.Size.Y / 2
		local pos = Vector3.new(slotPart.Position.X, top + 2, slotPart.Position.Z)
		-- face the same way as the plot's open side (toward the belt)
		local lookAt = Vector3.new(0, pos.Y, 0)
		setCFrame(rec, CFrame.lookAt(pos, lookAt))
	end
	refreshRackAttr(plot)
end

local function dropOnGround(rec)
	setState(rec, "Dropped")
	rec.PlotId = nil
	rec.Slot = nil
	rec.DroppedAt = os.clock()
	rec.Prompt.Enabled = true
	local p = rec.Body.Position
	setCFrame(rec, CFrame.new(p.X, DROP_Y, p.Z))
end

-- ----------------------------------------------------------------------
-- Public: spawning / destroying
-- ----------------------------------------------------------------------
function InfluencerService.Init()
	folder = workspace:FindFirstChild("Influencers")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Influencers"
		folder.Parent = workspace
	end

	RunService.Heartbeat:Connect(function()
		InfluencerService.Update()
	end)
end

function InfluencerService.Spawn(rarityIdx, displayName)
	local rarity = Constants.RARITIES[rarityIdx] or Constants.RARITIES[1]
	local name = displayName or rarity.Names[rng:NextInteger(1, #rarity.Names)]
	local rec = {
		Rarity = rarityIdx,
		Name = name,
		Income = rarity.Income,
		State = "OnBelt",
		BeltX = Constants.BELT.StartX,
	}
	buildModel(rec)
	setCFrame(rec, CFrame.new(Constants.BELT.StartX, Constants.BELT.Height, 0))
	return rec
end

function InfluencerService.SetBeltPosition(rec, x)
	rec.BeltX = x
	setCFrame(rec, CFrame.new(x, Constants.BELT.Height, 0) * CFrame.Angles(0, math.rad(-90), 0))
end

function InfluencerService.Destroy(rec)
	if not rec or not rec.Model then
		return
	end
	if rec.State == "Carried" then
		endCarry(rec)
	end
	if rec.PlotId and rec.Slot then
		local plot = PlotService.GetPlotById(rec.PlotId)
		if plot and plot.Slots[rec.Slot] == rec then
			plot.Slots[rec.Slot] = nil
			refreshRackAttr(plot)
		end
	end
	if rec.OriginPlotId and rec.OriginSlot then
		local plot = PlotService.GetPlotById(rec.OriginPlotId)
		if plot and plot.Slots[rec.OriginSlot] == rec then
			plot.Slots[rec.OriginSlot] = nil
			refreshRackAttr(plot)
		end
	end
	records[rec.Model] = nil
	rec.Model:Destroy()
	rec.Model = nil
end

function InfluencerService.GetAllOnBelt()
	local list = {}
	for _, rec in pairs(records) do
		if rec.State == "OnBelt" then
			table.insert(list, rec)
		end
	end
	return list
end

function InfluencerService.CountOnBelt()
	local n = 0
	for _, rec in pairs(records) do
		if rec.State == "OnBelt" then
			n += 1
		end
	end
	return n
end

-- ----------------------------------------------------------------------
-- Public: grabbing (claim or steal)
-- ----------------------------------------------------------------------
function InfluencerService.OnGrab(player, rec)
	if not rec.Model then
		return
	end
	local uid = player.UserId
	if player:GetAttribute("Stunned") then
		return
	end
	if not PlotService.GetPlotByOwner(uid) then
		Notify(player, "All gyms are taken — you need a gym to hold influencers.", "fail")
		return
	end

	if rec.State == "OnBelt" or rec.State == "Dropped" then
		if carriedBy[uid] then
			Notify(player, "You're already carrying someone! Rack them first.", "fail")
			return
		end
		startCarry(player, rec)
		Notify(player, "Claimed " .. rec.Name .. "! Get him to your rack.", "success")
		return
	end

	if rec.State == "Placed" then
		local plot = PlotService.GetPlotById(rec.PlotId)
		if not plot then
			return
		end
		if plot.OwnerUserId == uid then
			Notify(player, rec.Name .. " is already training at your gym.", "info")
			return
		end
		if carriedBy[uid] then
			Notify(player, "You're already carrying someone!", "fail")
			return
		end
		-- THEFT: keep the origin slot reserved so it can return if the thief is caught
		rec.OriginPlotId = plot.Id
		rec.OriginSlot = rec.Slot
		rec.PlotId = nil
		rec.Slot = nil
		startCarry(player, rec)
		refreshRackAttr(plot)

		local victim = PlotService.GetOwnerPlayer(plot)
		Notify(player, "You grabbed " .. rec.Name .. "! RUN to your rack before the front desk catches you!", "info")
		if victim then
			Notify(victim, player.DisplayName .. " is stealing your " .. rec.Name .. "!", "fail")
		end
		if InfluencerService.OnTheftStarted then
			InfluencerService.OnTheftStarted(rec, player, plot)
		end
	end
end

function InfluencerService.GetCarried(player)
	return carriedBy[player.UserId]
end

function InfluencerService.GetCarrierPlayer(rec)
	return rec.CarrierUserId and Players:GetPlayerByUserId(rec.CarrierUserId) or nil
end

-- ----------------------------------------------------------------------
-- Public: placing / dropping / returning
-- ----------------------------------------------------------------------
function InfluencerService.Place(rec, plot, slot, ownerPlayer)
	-- Successful theft? Free the victim's slot and tell them.
	if rec.OriginPlotId then
		local originPlot = PlotService.GetPlotById(rec.OriginPlotId)
		if originPlot then
			if originPlot.Slots[rec.OriginSlot] == rec then
				originPlot.Slots[rec.OriginSlot] = nil
			end
			local victim = PlotService.GetOwnerPlayer(originPlot)
			if victim then
				removeFromProfile(victim, rec.OriginSlot)
				Notify(victim, (ownerPlayer and ownerPlayer.DisplayName or "Someone") .. " stole your " .. rec.Name .. "!", "fail")
			end
			refreshRackAttr(originPlot)
			if InfluencerService.OnTheftEnded then
				InfluencerService.OnTheftEnded(rec, originPlot)
			end
		end
		rec.OriginPlotId = nil
		rec.OriginSlot = nil
	end

	endCarry(rec)
	placeAt(rec, plot, slot)

	local owner = ownerPlayer or PlotService.GetOwnerPlayer(plot)
	if owner then
		addToProfile(owner, rec)
		Notify(owner, rec.Name .. " is now training at your gym! +$" .. Constants.FormatNumber(rec.Income) .. "/s", "success")
	end
end

function InfluencerService.ReturnToOrigin(rec)
	local originPlot = rec.OriginPlotId and PlotService.GetPlotById(rec.OriginPlotId)
	local originSlot = rec.OriginSlot
	rec.OriginPlotId = nil
	rec.OriginSlot = nil
	endCarry(rec)

	if originPlot and originPlot.OwnerUserId ~= 0 and originPlot.Slots[originSlot] == rec then
		placeAt(rec, originPlot, originSlot)
	else
		dropOnGround(rec)
	end
	if InfluencerService.OnTheftEnded and originPlot then
		InfluencerService.OnTheftEnded(rec, originPlot)
	end
end

-- Drop whatever the player is carrying (death, leaving, rebirth, manual).
function InfluencerService.DropCarried(player)
	local rec = carriedBy[player.UserId]
	if not rec then
		return
	end
	if rec.OriginPlotId then
		InfluencerService.ReturnToOrigin(rec)
	else
		endCarry(rec)
		dropOnGround(rec)
	end
end

-- Destroys every influencer placed on a plot (does NOT touch the profile).
function InfluencerService.ClearPlot(plot)
	for slot, rec in pairs(plot.Slots) do
		if rec and rec.State == "Placed" then
			InfluencerService.Destroy(rec)
		end
		plot.Slots[slot] = nil
	end
	refreshRackAttr(plot)
end

-- Rebuilds a player's saved rack when they join.
function InfluencerService.RestorePlaced(player, plot)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return 0
	end
	local restored = 0
	for _, entry in ipairs(profile.Placed) do
		local slot = entry.Slot
		if slot and slot <= plot.Unlocked and not plot.Slots[slot] and Constants.RARITIES[entry.Rarity] then
			local rec = {
				Rarity = entry.Rarity,
				Name = entry.Name or Constants.RARITIES[entry.Rarity].Names[1],
				Income = Constants.RARITIES[entry.Rarity].Income,
				State = "Placed",
			}
			buildModel(rec)
			placeAt(rec, plot, slot)
			restored += 1
		end
	end
	return restored
end

-- ----------------------------------------------------------------------
-- Rack zone check: is the carrier standing inside their OWN RackZone?
-- (Position test instead of .Touched so standing still inside still works.)
-- ----------------------------------------------------------------------
local function insideZone(zone, point)
	local rel = zone.CFrame:PointToObjectSpace(point)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

local function checkRackDrop(player, rec, hrp)
	local plot = PlotService.GetPlotByOwner(player.UserId)
	local zone = plot and plot.Model:FindFirstChild("RackZone")
	if not zone or not insideZone(zone, hrp.Position) then
		return
	end
	local slot = PlotService.FindOpenSlot(plot.Id)
	if not slot then
		local now = os.clock()
		if not rackTouchDebounce[player.UserId] or now - rackTouchDebounce[player.UserId] > 4 then
			rackTouchDebounce[player.UserId] = now
			Notify(player, "Rack is full! Upgrade Rack Slots in the Shop.", "fail")
		end
		return
	end
	InfluencerService.Place(rec, plot, slot, player)
end

-- ----------------------------------------------------------------------
-- Heartbeat
-- ----------------------------------------------------------------------
local despawnAccum = 0
local zoneAccum = 0

function InfluencerService.Update()
	zoneAccum += 1
	local doZoneCheck = zoneAccum >= 6
	if doZoneCheck then
		zoneAccum = 0
	end

	-- carried: follow the carrier
	for uid, rec in pairs(carriedBy) do
		local player = Players:GetPlayerByUserId(uid)
		local character = player and player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if hrp and humanoid and humanoid.Health > 0 then
			setCFrame(rec, hrp.CFrame * CARRY_OFFSET)
			if doZoneCheck and player then
				checkRackDrop(player, rec, hrp)
			end
		else
			if player then
				InfluencerService.DropCarried(player)
			else
				endCarry(rec)
				dropOnGround(rec)
			end
		end
	end

	-- dropped: despawn after a while (checked ~once per second)
	despawnAccum += 1
	if despawnAccum >= 60 then
		despawnAccum = 0
		local now = os.clock()
		for _, rec in pairs(records) do
			if rec.State == "Dropped" and rec.DroppedAt and now - rec.DroppedAt > Constants.BELT.DroppedDespawn then
				InfluencerService.Destroy(rec)
			end
		end
	end
end

return InfluencerService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	GYM WARS — server bootstrap
	Wires every service together and handles join / leave / respawn.
]]

local Players = game:GetService("Players")
local SSS = game:GetService("ServerScriptService")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local InfluencerService = require(SSS.InfluencerService)
local BeltService = require(SSS.BeltService)
local EconomyService = require(SSS.EconomyService)
local WorkoutService = require(SSS.WorkoutService)
local ShopService = require(SSS.ShopService)
local DefenseService = require(SSS.DefenseService)
local Notify = require(SSS.Notify)

-- ----------------------------------------------------------------------
-- Init order matters: plots first (everything hangs off them)
-- ----------------------------------------------------------------------
PlotService.Init()
InfluencerService.Init()
DefenseService.Init()
BeltService.Init()
EconomyService.Init()
WorkoutService.Init()
ShopService.Init()

-- ----------------------------------------------------------------------
local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.WalkSpeed = Constants.NORMAL_WALKSPEED
		humanoid.Died:Connect(function()
			InfluencerService.DropCarried(player)
		end)
	end
	player:SetAttribute("Stunned", false)
	player:SetAttribute("Carrying", "")

	local plot = PlotService.GetPlotByOwner(player.UserId)
	if plot then
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait() -- let the default spawn finish before moving
		PlotService.TeleportToPlot(player, plot)
	end
end

local function onPlayerAdded(player)
	local profile = PlayerDataService.LoadPlayer(player)
	local plot = PlotService.AssignPlot(player)

	if plot then
		local rackLevel = profile.Equipment.RackSlots or 1
		local slots = Constants.EQUIPMENT.RackSlots.Values[rackLevel]
		PlotService.RefreshSlots(plot.Id, slots)
		PlotService.ApplyColor(plot.Id, profile.GymColor or 1)
		local restored = InfluencerService.RestorePlaced(player, plot)
		player:SetAttribute("RackSlots", slots)
		player:SetAttribute("RackUsed", PlotService.CountPlaced(plot.Id))
		task.delay(3, function()
			if restored > 0 then
				Notify(player, "Welcome back! " .. restored .. " influencers are still training at your gym.", "success")
			else
				Notify(player, "Grab gym bros off the belt and bring them to your rack!", "info")
			end
		end)
	else
		task.delay(3, function()
			Notify(player, "Server is full of gyms — you can still explore, but you need a gym to earn.", "fail")
		end)
	end

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

local function onPlayerRemoving(player)
	InfluencerService.DropCarried(player)

	local plot = PlotService.GetPlotByOwner(player.UserId)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if plot and profile then
		-- anything being stolen from this gym right now is gone for good
		for slot, rec in pairs(plot.Slots) do
			if rec and rec.State == "Carried" then
				for i = #profile.Placed, 1, -1 do
					if profile.Placed[i].Slot == slot then
						table.remove(profile.Placed, i)
					end
				end
			end
		end
	end

	PlayerDataService.SaveData(player)

	if plot then
		InfluencerService.ClearPlot(plot)
		DefenseService.ResetPlot(plot)
		PlotService.ReleasePlot(player)
	end

	EconomyService.ClearPlayer(player)
	WorkoutService.ClearPlayer(player)
	ShopService.ClearPlayer(player)
	PlayerDataService.Cleanup(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- ----------------------------------------------------------------------
-- Autosave + shutdown save
-- ----------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(Constants.AUTOSAVE_INTERVAL)
		PlayerDataService.SaveAll()
	end
end)

game:BindToClose(function()
	PlayerDataService.SaveAll()
	task.wait(1)
end)

print("[GymWars] Server ready — " .. Constants.PLOT_COUNT .. " gyms, belt running.")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">Notify</string>
        <string name="Source"><![CDATA[-- Tiny helper: send a toast to one player's HUD.
-- kind: "info" | "success" | "fail"
local RS = game:GetService("ReplicatedStorage")
local NotifyRemote = RS:WaitForChild("Remotes"):WaitForChild("Notify")

return function(player, text, kind)
	if player and player.Parent then
		NotifyRemote:FireClient(player, { Text = text, Kind = kind or "info" })
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="18">
      <Properties>
        <string name="Name">PlayerDataService</string>
        <string name="Source"><![CDATA[--[[
	PlayerDataService
	Owns the per-player profile, its persistence, leaderstats and the
	attribute mirror the client HUD reads from.

	PROFILE SCHEMA
	  Resets on rebirth : Cash, Placed
	  Permanent          : Strength, Rebirths, OwnedClothing, Equipped, Equipment, GymColor
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)

local PlayerDataService = {}

local cache = {} -- [userId] = profile
local store = nil

local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Constants.DATASTORE_NAME)
end)
if not storeOk then
	warn("[PlayerDataService] DataStore unavailable (unpublished place or API access off). Progress will not persist.")
end

local function key(userId)
	return "Player_" .. tostring(userId)
end

local function defaultProfile()
	return {
		Cash = 0,
		Strength = 0,
		Rebirths = 0,
		OwnedClothing = {}, -- [clothingId] = true
		Equipped = {}, -- [slotName] = clothingId
		Equipment = { RackSlots = 1, WorkoutGain = 1, DeskSpeed = 1 },
		GymColor = 1,
		Placed = {}, -- list of { Rarity = index, Name = string, Slot = number }
	}
end

local function mergeDefaults(data)
	local profile = defaultProfile()
	if type(data) ~= "table" then
		return profile
	end
	for k, v in pairs(data) do
		profile[k] = v
	end
	-- nested defaults
	for k, v in pairs(defaultProfile().Equipment) do
		if type(profile.Equipment) ~= "table" then
			profile.Equipment = {}
		end
		if profile.Equipment[k] == nil then
			profile.Equipment[k] = v
		end
	end
	if type(profile.OwnedClothing) ~= "table" then
		profile.OwnedClothing = {}
	end
	if type(profile.Equipped) ~= "table" then
		profile.Equipped = {}
	end
	if type(profile.Placed) ~= "table" then
		profile.Placed = {}
	end
	return profile
end

-- ----------------------------------------------------------------------
-- Sync helpers
-- ----------------------------------------------------------------------
function PlayerDataService.SyncLeaderstats(player)
	local profile = cache[player.UserId]
	local ls = player:FindFirstChild("leaderstats")
	if not profile or not ls then
		return
	end
	local cash = ls:FindFirstChild("Cash")
	local strength = ls:FindFirstChild("Strength")
	local rebirths = ls:FindFirstChild("Rebirths")
	if cash then
		cash.Value = math.floor(profile.Cash)
	end
	if strength then
		strength.Value = math.floor(profile.Strength)
	end
	if rebirths then
		rebirths.Value = profile.Rebirths
	end
end

function PlayerDataService.SyncAttributes(player)
	local profile = cache[player.UserId]
	if not profile then
		return
	end
	player:SetAttribute("OwnedClothing", HttpService:JSONEncode(profile.OwnedClothing))
	player:SetAttribute("Equipped", HttpService:JSONEncode(profile.Equipped))
	player:SetAttribute("Equipment", HttpService:JSONEncode(profile.Equipment))
	player:SetAttribute("GymColor", profile.GymColor)
	player:SetAttribute("RebirthThreshold", Constants.RebirthThreshold(profile.Rebirths))
	player:SetAttribute("RebirthMultiplier", Constants.RebirthMultiplier(profile.Rebirths))
end

-- ----------------------------------------------------------------------
-- Load / access
-- ----------------------------------------------------------------------
function PlayerDataService.LoadPlayer(player)
	local data = nil
	if store then
		local ok, err = pcall(function()
			data = store:GetAsync(key(player.UserId))
		end)
		if not ok then
			warn("[PlayerDataService] Load failed for " .. player.Name .. ": " .. tostring(err))
		end
	end

	local profile = mergeDefaults(data)
	cache[player.UserId] = profile

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cash = Instance.new("NumberValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats

	local strength = Instance.new("IntValue")
	strength.Name = "Strength"
	strength.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats

	leaderstats.Parent = player

	PlayerDataService.SyncLeaderstats(player)
	PlayerDataService.SyncAttributes(player)
	return profile
end

function PlayerDataService.GetProfile(userId)
	return cache[userId]
end

-- ----------------------------------------------------------------------
-- Mutators
-- ----------------------------------------------------------------------
function PlayerDataService.AddCash(player, delta)
	local profile = cache[player.UserId]
	if not profile then
		return 0
	end
	profile.Cash = math.max(0, profile.Cash + delta)
	PlayerDataService.SyncLeaderstats(player)
	return profile.Cash
end

function PlayerDataService.SetCash(player, value)
	local profile = cache[player.UserId]
	if not profile then
		return
	end
	profile.Cash = math.max(0, value)
	PlayerDataService.SyncLeaderstats(player)
end

function PlayerDataService.AddStrength(player, delta)
	local profile = cache[player.UserId]
	if not profile then
		return 0
	end
	profile.Strength = math.max(0, profile.Strength + delta)
	PlayerDataService.SyncLeaderstats(player)
	return profile.Strength
end

-- ----------------------------------------------------------------------
-- Save
-- ----------------------------------------------------------------------
function PlayerDataService.SaveData(player)
	local profile = cache[player.UserId]
	if not profile or not store then
		return
	end
	local snapshot = {
		Cash = profile.Cash,
		Strength = profile.Strength,
		Rebirths = profile.Rebirths,
		OwnedClothing = profile.OwnedClothing,
		Equipped = profile.Equipped,
		Equipment = profile.Equipment,
		GymColor = profile.GymColor,
		Placed = profile.Placed,
	}
	local ok, err = pcall(function()
		store:SetAsync(key(player.UserId), snapshot)
	end)
	if not ok then
		warn("[PlayerDataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

function PlayerDataService.SaveAll()
	for _, player in ipairs(Players:GetPlayers()) do
		PlayerDataService.SaveData(player)
	end
end

function PlayerDataService.Cleanup(player)
	cache[player.UserId] = nil
end

return PlayerDataService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="19">
      <Properties>
        <string name="Name">PlotService</string>
        <string name="Source"><![CDATA[--[[
	PlotService
	Assigns the 8 static gym plots to players, handles sign text, gym colors,
	rack-slot visuals and teleporting players home.
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)

local PlotService = {}

local plots = {} -- [plotId] = plot record
local ownerToPlot = {} -- [userId] = plotId

local WALL_PARTS = { "Floor", "WallBack", "WallLeft", "WallRight" }
local ACCENT_PARTS = { "Sign", "FrontDesk" }

local LOCKED_SLOT_COLOR = Color3.fromRGB(28, 30, 38)
local OPEN_SLOT_COLOR = Color3.fromRGB(120, 200, 150)

-- ----------------------------------------------------------------------
local function makeSignGui(signPart)
	local gui = signPart:FindFirstChild("SignGui")
	if gui then
		return gui
	end
	gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = signPart

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = "OPEN GYM"
	label.Parent = gui

	-- back face copy so it reads from inside the gym too
	local back = gui:Clone()
	back.Name = "SignGuiBack"
	back.Face = Enum.NormalId.Back
	back.Parent = signPart

	return gui
end

-- ----------------------------------------------------------------------
function PlotService.Init()
	local folder = workspace:WaitForChild("GymWarsMap"):WaitForChild("Plots")
	for i = 1, Constants.PLOT_COUNT do
		local model = folder:FindFirstChild("Plot" .. i)
		if model then
			model:SetAttribute("PlotId", i)
			model:SetAttribute("OwnerUserId", 0)
			plots[i] = {
				Id = i,
				Model = model,
				OwnerUserId = 0,
				Slots = {}, -- [slotIndex] = influencer record
				Unlocked = 0,
			}
			makeSignGui(model:WaitForChild("Sign"))
			PlotService.SetSignText(i, "OPEN GYM")
			PlotService.ApplyColor(i, 1)
			PlotService.RefreshSlots(i, 0)
		else
			warn("[PlotService] Missing Plot" .. i .. " in GymWarsMap.Plots")
		end
	end
end

function PlotService.GetPlotById(id)
	return plots[id]
end

function PlotService.GetPlotByOwner(userId)
	local id = ownerToPlot[userId]
	return id and plots[id] or nil
end

function PlotService.GetAllPlots()
	return plots
end

-- Walk up from any instance to find which plot it belongs to.
function PlotService.GetPlotFromInstance(inst)
	local node = inst
	while node and node ~= workspace do
		local id = node:GetAttribute("PlotId")
		if id then
			return plots[id]
		end
		node = node.Parent
	end
	return nil
end

-- ----------------------------------------------------------------------
function PlotService.AssignPlot(player)
	if ownerToPlot[player.UserId] then
		return plots[ownerToPlot[player.UserId]]
	end
	for i = 1, Constants.PLOT_COUNT do
		local plot = plots[i]
		if plot and plot.OwnerUserId == 0 then
			plot.OwnerUserId = player.UserId
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			ownerToPlot[player.UserId] = i
			player:SetAttribute("PlotId", i)
			PlotService.SetSignText(i, player.DisplayName .. "'s Gym")
			return plot
		end
	end
	return nil
end

function PlotService.ReleasePlot(player)
	local id = ownerToPlot[player.UserId]
	if not id then
		return
	end
	local plot = plots[id]
	plot.OwnerUserId = 0
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.Slots = {}
	ownerToPlot[player.UserId] = nil
	PlotService.SetSignText(id, "OPEN GYM")
	PlotService.ApplyColor(id, 1)
	PlotService.RefreshSlots(id, 0)
end

-- ----------------------------------------------------------------------
function PlotService.SetSignText(plotId, text)
	local plot = plots[plotId]
	if not plot then
		return
	end
	local sign = plot.Model:FindFirstChild("Sign")
	if not sign then
		return
	end
	for _, guiName in ipairs({ "SignGui", "SignGuiBack" }) do
		local gui = sign:FindFirstChild(guiName)
		local label = gui and gui:FindFirstChild("Label")
		if label then
			label.Text = text
		end
	end
end

function PlotService.ApplyColor(plotId, presetIndex)
	local plot = plots[plotId]
	local preset = Constants.GYM_COLORS[presetIndex] or Constants.GYM_COLORS[1]
	if not plot or not preset then
		return
	end
	for _, name in ipairs(WALL_PARTS) do
		local p = plot.Model:FindFirstChild(name)
		if p then
			p.Color = preset.Wall
		end
	end
	for _, name in ipairs(ACCENT_PARTS) do
		local p = plot.Model:FindFirstChild(name)
		if p then
			p.Color = preset.Accent
		end
	end
end

-- Lights up the first `unlockedCount` slot plates, dims the rest.
function PlotService.RefreshSlots(plotId, unlockedCount)
	local plot = plots[plotId]
	if not plot then
		return
	end
	plot.Unlocked = unlockedCount
	for k = 1, Constants.RACK_SLOT_MAX do
		local slot = plot.Model:FindFirstChild("Slot" .. k)
		if slot then
			if k <= unlockedCount then
				slot.Color = OPEN_SLOT_COLOR
				slot.Transparency = 0.2
				slot.Material = Enum.Material.Neon
			else
				slot.Color = LOCKED_SLOT_COLOR
				slot.Transparency = 0.6
				slot.Material = Enum.Material.SmoothPlastic
			end
		end
	end
end

function PlotService.GetSlotPart(plotId, k)
	local plot = plots[plotId]
	return plot and plot.Model:FindFirstChild("Slot" .. k) or nil
end

function PlotService.FindOpenSlot(plotId)
	local plot = plots[plotId]
	if not plot then
		return nil
	end
	for k = 1, plot.Unlocked do
		if not plot.Slots[k] then
			return k
		end
	end
	return nil
end

function PlotService.CountPlaced(plotId)
	local plot = plots[plotId]
	if not plot then
		return 0
	end
	local n = 0
	for _ in pairs(plot.Slots) do
		n += 1
	end
	return n
end

-- ----------------------------------------------------------------------
function PlotService.TeleportToPlot(player, plot)
	local character = player.Character
	local spawnPart = plot and plot.Model:FindFirstChild("PlotSpawn")
	if not character or not spawnPart then
		return
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	-- face the belt (map center)
	local from = spawnPart.Position + Vector3.new(0, 1, 0)
	local lookAt = Vector3.new(0, from.Y, 0)
	character:PivotTo(CFrame.lookAt(from, lookAt))
end

function PlotService.GetOwnerPlayer(plot)
	if not plot or plot.OwnerUserId == 0 then
		return nil
	end
	return Players:GetPlayerByUserId(plot.OwnerUserId)
end

return PlotService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">ShopService</string>
        <string name="Source"><![CDATA[--[[
	ShopService
	Server-authoritative purchases. The client only ever asks; the server
	validates Strength gates, Cash, and levels before changing anything.

	Remotes (RemoteFunction):
	  Purchase:InvokeServer(kind, id)   kind = "Clothing" | "Equipment" | "Booster"
	  Equip:InvokeServer(clothingId)    equips an OWNED clothing item into its slot
	  Rebirth:InvokeServer()
	Remote (RemoteEvent):
	  SetGymColor:FireServer(presetIndex)
]]

local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local EconomyService = require(SSS.EconomyService)
local InfluencerService = require(SSS.InfluencerService)
local Notify = require(SSS.Notify)

local ShopService = {}

local Remotes = RS:WaitForChild("Remotes")
local colorCooldown = {} -- [userId] = os.clock()

-- ----------------------------------------------------------------------
-- Clothing: Strength unlocks the RIGHT to buy. Cash is still required.
-- ----------------------------------------------------------------------
local function buyClothing(player, profile, id)
	local item = Constants.GetClothing(id)
	if not item then
		return false, "Unknown item."
	end
	if profile.OwnedClothing[id] then
		return false, "You already own " .. item.Name .. "."
	end
	if profile.Strength < item.Strength then
		return false, "Need " .. Constants.FormatNumber(item.Strength) .. " Strength to unlock " .. item.Name .. "."
	end
	if profile.Cash < item.Price then
		return false, "Need $" .. Constants.FormatNumber(item.Price) .. " for " .. item.Name .. "."
	end

	PlayerDataService.AddCash(player, -item.Price)
	profile.OwnedClothing[id] = true
	-- auto-equip if it beats (or fills) the current slot
	local currentId = profile.Equipped[item.Slot]
	local current = currentId and Constants.GetClothing(currentId)
	if not current or item.Bonus > current.Bonus then
		profile.Equipped[item.Slot] = id
	end
	PlayerDataService.SyncAttributes(player)
	return true, "Bought " .. item.Name .. "! +" .. math.floor(item.Bonus * 100) .. "% income"
end

local function equipClothing(player, profile, id)
	local item = Constants.GetClothing(id)
	if not item or not profile.OwnedClothing[id] then
		return false, "You don't own that."
	end
	profile.Equipped[item.Slot] = id
	PlayerDataService.SyncAttributes(player)
	return true, "Equipped " .. item.Name .. "."
end

-- ----------------------------------------------------------------------
-- Equipment: permanent, Cash-only
-- ----------------------------------------------------------------------
local function buyEquipment(player, profile, id)
	local def = Constants.EQUIPMENT[id]
	if not def then
		return false, "Unknown upgrade."
	end
	local level = profile.Equipment[id] or 1
	if level >= #def.Values then
		return false, def.Name .. " is maxed out."
	end
	local cost = def.Costs[level + 1]
	if profile.Cash < cost then
		return false, "Need $" .. Constants.FormatNumber(cost) .. " for the next " .. def.Name .. " level."
	end

	PlayerDataService.AddCash(player, -cost)
	profile.Equipment[id] = level + 1
	PlayerDataService.SyncAttributes(player)

	-- apply side effects immediately
	local plot = PlotService.GetPlotByOwner(player.UserId)
	if plot then
		if id == "RackSlots" then
			PlotService.RefreshSlots(plot.Id, def.Values[level + 1])
			player:SetAttribute("RackSlots", def.Values[level + 1])
		end
	end
	if ShopService.OnEquipmentChanged then
		ShopService.OnEquipmentChanged(player, id, level + 1)
	end
	return true, def.Name .. " upgraded to level " .. (level + 1) .. "!"
end

-- ----------------------------------------------------------------------
-- Boosters: temporary, Cash-only
-- ----------------------------------------------------------------------
local function buyBooster(player, profile, id)
	local b = Constants.GetBooster(id)
	if not b then
		return false, "Unknown booster."
	end
	if profile.Cash < b.Price then
		return false, "Need $" .. Constants.FormatNumber(b.Price) .. " for " .. b.Name .. "."
	end
	PlayerDataService.AddCash(player, -b.Price)
	EconomyService.ActivateBooster(player, b)
	return true, b.Name .. " active! " .. b.Desc
end

-- ----------------------------------------------------------------------
-- Rebirth: resets Cash + placed influencers ONLY.
-- Strength, clothing, equipment, gym color are permanent.
-- ----------------------------------------------------------------------
function ShopService.DoRebirth(player)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return false, "Profile not loaded."
	end
	local threshold = Constants.RebirthThreshold(profile.Rebirths)
	if profile.Cash < threshold then
		return false, "Need $" .. Constants.FormatNumber(threshold) .. " to rebirth."
	end

	-- drop anything in hand so nothing gets lost mid-carry
	InfluencerService.DropCarried(player)

	-- RESETS
	PlayerDataService.SetCash(player, 0)
	profile.Placed = {}
	local plot = PlotService.GetPlotByOwner(player.UserId)
	if plot then
		InfluencerService.ClearPlot(plot)
	end

	-- PERMANENT GAIN
	profile.Rebirths += 1
	PlayerDataService.SyncLeaderstats(player)
	PlayerDataService.SyncAttributes(player)

	local mult = Constants.RebirthMultiplier(profile.Rebirths)
	return true, string.format("REBIRTH %d! Permanent income x%.2f", profile.Rebirths, mult)
end

-- ----------------------------------------------------------------------
function ShopService.Init()
	Remotes.Purchase.OnServerInvoke = function(player, kind, id)
		local profile = PlayerDataService.GetProfile(player.UserId)
		if not profile or type(kind) ~= "string" or type(id) ~= "string" then
			return false, "Invalid request."
		end
		local ok, msg
		if kind == "Clothing" then
			ok, msg = buyClothing(player, profile, id)
		elseif kind == "Equipment" then
			ok, msg = buyEquipment(player, profile, id)
		elseif kind == "Booster" then
			ok, msg = buyBooster(player, profile, id)
		else
			ok, msg = false, "Invalid shop category."
		end
		Notify(player, msg, ok and "success" or "fail")
		return ok, msg
	end

	Remotes.Equip.OnServerInvoke = function(player, id)
		local profile = PlayerDataService.GetProfile(player.UserId)
		if not profile or type(id) ~= "string" then
			return false, "Invalid request."
		end
		local ok, msg = equipClothing(player, profile, id)
		Notify(player, msg, ok and "success" or "fail")
		return ok, msg
	end

	Remotes.Rebirth.OnServerInvoke = function(player)
		local ok, msg = ShopService.DoRebirth(player)
		Notify(player, msg, ok and "success" or "fail")
		return ok, msg
	end

	Remotes.SetGymColor.OnServerEvent:Connect(function(player, index)
		if type(index) ~= "number" or not Constants.GYM_COLORS[index] then
			return
		end
		local now = os.clock()
		if colorCooldown[player.UserId] and now - colorCooldown[player.UserId] < 0.5 then
			return
		end
		colorCooldown[player.UserId] = now
		local profile = PlayerDataService.GetProfile(player.UserId)
		local plot = PlotService.GetPlotByOwner(player.UserId)
		if not profile or not plot then
			return
		end
		profile.GymColor = index
		PlotService.ApplyColor(plot.Id, index)
		PlayerDataService.SyncAttributes(player)
	end)
end

function ShopService.ClearPlayer(player)
	colorCooldown[player.UserId] = nil
end

return ShopService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="21">
      <Properties>
        <string name="Name">WorkoutService</string>
        <string name="Source"><![CDATA[--[[
	WorkoutService
	Each plot's WorkoutStation has a ProximityPrompt. Only the owner can use
	their own station. Each rep adds Strength (permanent, never reset):
	  gain = BaseGain * WorkoutGain equipment value
	Rep cooldown is divided by active WorkoutSpeed boosters (Creatine).
]]

local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local EconomyService = require(SSS.EconomyService)
local Notify = require(SSS.Notify)

local WorkoutService = {}

local lastRep = {} -- [userId] = os.clock()

local function doRep(player, plot)
	if plot.OwnerUserId ~= player.UserId then
		Notify(player, "That's not your gym! Go lift at your own station.", "fail")
		return
	end
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return
	end

	local speed = EconomyService.BoosterMultiplier(player.UserId, "WorkoutSpeed")
	local cooldown = Constants.WORKOUT.RepCooldown / speed
	local now = os.clock()
	if lastRep[player.UserId] and now - lastRep[player.UserId] < cooldown then
		return
	end
	lastRep[player.UserId] = now

	local level = profile.Equipment.WorkoutGain or 1
	local gainPerRep = Constants.EQUIPMENT.WorkoutGain.Values[level] or 1
	PlayerDataService.AddStrength(player, Constants.WORKOUT.BaseGain * gainPerRep)
end

function WorkoutService.Init()
	for _, plot in pairs(PlotService.GetAllPlots()) do
		local station = plot.Model:FindFirstChild("WorkoutStation")
		if station then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "WorkoutPrompt"
			prompt.ActionText = "Do a Rep"
			prompt.ObjectText = "Workout Station"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = Constants.WORKOUT.PromptDistance
			prompt.RequiresLineOfSight = false
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.Parent = station

			prompt.Triggered:Connect(function(player)
				doRep(player, plot)
			end)
		end
	end
end

function WorkoutService.ClearPlayer(player)
	lastRep[player.UserId] = nil
end

return WorkoutService
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="22">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">GymWarsClient</string>
          <string name="Source"><![CDATA[--[[
	GYM WARS — client UI
	HUD, Shop (Clothing / Equipment / Boosters), Rebirth panel, Gym color picker,
	toasts. Everything is built in code (no external assets) and reads state
	from leaderstats + player attributes that the server keeps in sync.
	The client never changes game state itself — it only asks the server.
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local Constants = require(RS:WaitForChild("Modules"):WaitForChild("Constants"))
local Remotes = RS:WaitForChild("Remotes")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ======================================================================
-- Style
-- ======================================================================
local PANEL = Color3.fromRGB(20, 22, 30)
local PANEL_2 = Color3.fromRGB(30, 33, 44)
local TEXT = Color3.fromRGB(240, 242, 248)
local SUB = Color3.fromRGB(150, 158, 175)
local GOLD = Color3.fromRGB(244, 201, 58)
local GREEN = Color3.fromRGB(90, 220, 120)
local RED = Color3.fromRGB(230, 80, 70)
local BLUE = Color3.fromRGB(79, 157, 251)
local PURPLE = Color3.fromRGB(176, 107, 240)
local LOCKED = Color3.fromRGB(70, 74, 88)

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(60, 64, 80)
	s.Thickness = thickness or 1.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = props.Font or Enum.Font.GothamBold
	l.TextSize = props.TextSize or 14
	l.TextColor3 = props.Color or TEXT
	l.TextXAlignment = props.XAlign or Enum.TextXAlignment.Left
	l.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	l.TextWrapped = props.Wrapped or false
	l.RichText = props.Rich or false
	l.Size = props.Size or UDim2.new(1, 0, 0, 20)
	l.Position = props.Position or UDim2.new(0, 0, 0, 0)
	l.Text = props.Text or ""
	l.Name = props.Name or "Label"
	l.Parent = parent
	return l
end

local function button(parent, props)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BackgroundColor3 = props.Color or GREEN
	b.Font = Enum.Font.GothamBlack
	b.TextSize = props.TextSize or 14
	b.TextColor3 = props.TextColor or Color3.fromRGB(15, 15, 20)
	b.Size = props.Size or UDim2.new(0, 100, 0, 34)
	b.Position = props.Position or UDim2.new(0, 0, 0, 0)
	b.AnchorPoint = props.Anchor or Vector2.new(0, 0)
	b.Text = props.Text or ""
	b.Name = props.Name or "Button"
	b.Parent = parent
	corner(b, props.Radius or 8)
	return b
end

local function decode(attr, fallback)
	local raw = player:GetAttribute(attr)
	if type(raw) ~= "string" or raw == "" then
		return fallback
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(data) == "table" then
		return data
	end
	return fallback
end

local fmt = Constants.FormatNumber

-- ======================================================================
-- Root
-- ======================================================================
local gui = Instance.new("ScreenGui")
gui.Name = "GymWarsUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

-- ======================================================================
-- Stats panel (top-left)
-- ======================================================================
local stats = Instance.new("Frame")
stats.Name = "Stats"
stats.Size = UDim2.new(0, 250, 0, 150)
stats.Position = UDim2.new(0, 14, 0, 14)
stats.BackgroundColor3 = PANEL
stats.BackgroundTransparency = 0.08
