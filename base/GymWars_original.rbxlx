	Font = Enum.Font.GothamBlack,
	TextSize = 34,
	Color = RED,
	XAlign = Enum.TextXAlignment.Center,
	Size = UDim2.new(0, 520, 0, 40),
	Position = UDim2.new(0.5, -260, 0.35, 0),
