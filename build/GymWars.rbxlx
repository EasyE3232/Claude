    <Item class="ModuleScript" referent="23">
      <Properties>
        <string name="Name">NpcService</string>
        <string name="Source"><![CDATA[--[[
	NpcService
	Real R15 humanoid NPCs for influencers and front-desk workers.

	- Rig creation: Players:CreateHumanoidModelFromDescriptionAsync (falls back
	  to the old API, then to a code-built block rig so NPCs always exist).
	- Collision groups: NPCs never collide with players or each other, so they
	  can't block doorways or be body-blocked.
	- Locomotion animation: Roblox's own default R15 idle/walk/run animations,
	  blended by actual ground speed exactly like the default Animate script.
	- Movement controller: Follow(leader) and WalkTo(point) using direct
	  MoveTo when there's line of sight and PathfindingService when there
	  isn't, with stuck detection (jump, then re-path, then teleport).
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)
local BlockRig = require(RS.Modules.Gym.BlockRig)

local NpcService = {}

NpcService.GROUP_NPC = "NPC"
NpcService.GROUP_PLAYERS = "Players"

-- Roblox default R15 animations (owned by Roblox, usable in any experience)
local ANIMS = {
	Idle = "rbxassetid://507766388",
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://507767714",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	Wave = "rbxassetid://507770239",
	Cheer = "rbxassetid://507770677",
	Point = "rbxassetid://507770453",
	Dance = "rbxassetid://507771019",
}
NpcService.EMOTES = { "Wave", "Cheer", "Point", "Dance" }

local controllers = {} -- [model] = controller
local animSets = {} -- [model] = { tracks = {}, ... }
local descCache = {} -- [userId] = HumanoidDescription

-- ----------------------------------------------------------------------
-- Collision groups
-- ----------------------------------------------------------------------
function NpcService.Init()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(NpcService.GROUP_NPC)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(NpcService.GROUP_PLAYERS)
	end)
	PhysicsService:CollisionGroupSetCollidable(NpcService.GROUP_NPC, NpcService.GROUP_NPC, false)
	PhysicsService:CollisionGroupSetCollidable(NpcService.GROUP_NPC, NpcService.GROUP_PLAYERS, false)

	RunService.Heartbeat:Connect(NpcService._step)
end

function NpcService.SetGroup(model, group)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

-- ----------------------------------------------------------------------
-- Rig creation
-- ----------------------------------------------------------------------
local function buildDescription(opts)
	local desc
	local userId = opts.AvatarUserId
	if userId then
		desc = descCache[userId]
		if not desc then
			local ok, result = pcall(function()
				return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
			end)
			if not ok then
				ok, result = pcall(function()
					return Players:GetHumanoidDescriptionFromUserId(userId)
				end)
			end
			if ok and result then
				descCache[userId] = result
				desc = result
			end
		end
		if desc then
			return desc:Clone()
		end
	end

	desc = Instance.new("HumanoidDescription")
	local skin = opts.Skin or Color3.fromRGB(234, 184, 146)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.LeftLegColor = opts.Pants or Color3.fromRGB(38, 40, 48)
	desc.RightLegColor = opts.Pants or Color3.fromRGB(38, 40, 48)
	desc.TorsoColor = opts.Shirt or Color3.fromRGB(80, 80, 90)
	desc.HeightScale = opts.Height or 1
	desc.WidthScale = opts.Width or 1
	desc.DepthScale = opts.Depth or 1
	desc.HeadScale = 1
	desc.BodyTypeScale = 0
	desc.ProportionScale = 0
	return desc
end

local function createModel(desc)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
	end
	if ok and model and model:FindFirstChild("HumanoidRootPart") then
		return model, false
	end
	warn("[NpcService] Avatar rig creation failed, using block rig: " .. tostring(model))
	return nil, true
end

--[[
	opts = {
		Name, Skin, Shirt, Pants, Height, Width, Depth, AvatarUserId,
		Face = true (adds the classic face decal when the head has none)
	}
]]
function NpcService.CreateRig(opts)
	opts = opts or {}
	local desc = buildDescription(opts)
	local model, isBlock = createModel(desc)
	if isBlock then
		model = BlockRig.Build({ Skin = opts.Skin, Shirt = opts.Shirt, Pants = opts.Pants })
	end
	model.Name = opts.Name or "NPC"

	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.WalkSpeed = Constants.NPC.FollowSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 45
	for _, state in ipairs({
		Enum.HumanoidStateType.Dead,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.Swimming,
		Enum.HumanoidStateType.Seated,
	}) do
		humanoid:SetStateEnabled(state, false)
	end

	local head = model:FindFirstChild("Head")
	if head and opts.Face ~= false and not head:FindFirstChildOfClass("Decal") then
		local face = Instance.new("Decal")
		face.Name = "face"
		face.Texture = "rbxasset://textures/face.png"
		face.Face = Enum.NormalId.Front
		face.Parent = head
	end

	NpcService.SetGroup(model, NpcService.GROUP_NPC)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanTouch = false
		end
	end
	model.PrimaryPart = model:FindFirstChild("HumanoidRootPart")
	return model
end

-- Call after parenting into workspace.
function NpcService.Activate(model)
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and not hrp.Anchored then
		pcall(function()
			hrp:SetNetworkOwner(nil) -- server-owned: no exploit control, no ownership hand-off jitter
		end)
	end
	NpcService._ensureAnims(model)
end

-- ----------------------------------------------------------------------
-- Animation
-- ----------------------------------------------------------------------
function NpcService._ensureAnims(model)
	local set = animSets[model]
	if set then
		return set
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	set = { Tracks = {}, Animator = animator, Humanoid = humanoid, Enabled = true, Emote = nil }
	for key, id in pairs(ANIMS) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			local looped = key == "Idle" or key == "Walk" or key == "Run" or key == "Dance"
			track.Looped = looped
			track.Priority = (key == "Idle" or key == "Walk" or key == "Run") and Enum.AnimationPriority.Core
				or Enum.AnimationPriority.Action
			set.Tracks[key] = track
		end
	end
	animSets[model] = set
	model.Destroying:Connect(function()
		animSets[model] = nil
		controllers[model] = nil
	end)
	return set
end

-- Locomotion blending (mirrors the default Animate script's walk/run blend)
local function updateLocomotion(set, hrp, dt)
	if not set.Enabled then
		return
	end
	local v = hrp.AssemblyLinearVelocity
	-- speed relative to what we're standing on (so riding the conveyor = idle)
	local ground = set.Humanoid.FloorMaterial ~= Enum.Material.Air
	local groundVel = Vector3.zero
	if ground then
		local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), set.RayParams)
		if ray and ray.Instance then
			groundVel = ray.Instance.AssemblyLinearVelocity
		end
	end
	local flat = (v - groundVel) * Vector3.new(1, 0, 1)
	local speed = flat.Magnitude
	local tracks = set.Tracks
	local idle, walk, run = tracks.Idle, tracks.Walk, tracks.Run
	if not (idle and walk and run) then
		return
	end
	for _, t in ipairs({ idle, walk, run }) do
		if not t.IsPlaying then
			t:Play(0.2, 0.001, 1)
		end
	end
	local heightScale = math.max(set.Humanoid.HipHeight / 2, 0.5)
	local rs = speed * 1.25 / 16 / heightScale
	local wIdle, wWalk, wRun, warp = 0, 0, 0, 1
	if speed < 0.6 then
		wIdle = 1
	elseif rs <= 0.5 then
		wWalk, warp = 1, rs / 0.5
	elseif rs < 1 then
		local f = (rs - 0.5) / 0.5
		wWalk, wRun = 1 - f, f
	else
		wRun, warp = 1, rs
	end
	set.Weights = set.Weights or { 1, 0, 0 }
	local k = math.clamp(dt * 8, 0, 1)
	set.Weights[1] += (wIdle - set.Weights[1]) * k
	set.Weights[2] += (wWalk - set.Weights[2]) * k
	set.Weights[3] += (wRun - set.Weights[3]) * k
	idle:AdjustWeight(math.max(set.Weights[1], 0.001), 0.1)
	walk:AdjustWeight(math.max(set.Weights[2], 0.001), 0.1)
	run:AdjustWeight(math.max(set.Weights[3], 0.001), 0.1)
	walk:AdjustSpeed(math.max(warp, 0.1))
	run:AdjustSpeed(math.max(warp, 0.1))
end

function NpcService.PlayEmote(model, name)
	local set = NpcService._ensureAnims(model)
	local track = set and set.Tracks[name]
	if track and set.Enabled then
		if set.Emote and set.Emote.IsPlaying then
			set.Emote:Stop(0.2)
		end
		track:Play(0.2)
		set.Emote = track
		if track.Looped then
			task.delay(4, function()
				if set.Emote == track then
					track:Stop(0.4)
				end
			end)
		end
	end
end

-- Stop all server animation (the client drives the rig procedurally on machines)
function NpcService.SetAnimationsEnabled(model, enabled)
	local set = NpcService._ensureAnims(model)
	if not set then
		return
	end
	set.Enabled = enabled
	if not enabled then
		for _, t in pairs(set.Tracks) do
			t:Stop(0.1)
		end
	end
end

-- ----------------------------------------------------------------------
-- Movement controller
-- ----------------------------------------------------------------------
local AGENT = { AgentRadius = 2, AgentHeight = 5.5, AgentCanJump = true, WaypointSpacing = 6 }

local losParams = RaycastParams.new()
losParams.CollisionGroup = NpcService.GROUP_NPC
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.RespectCanCollide = true

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function hasLineOfSight(from, to)
	local a = from + Vector3.new(0, 0.5, 0)
	local b = to + Vector3.new(0, 0.5, 0)
	local dir = b - a
	if dir.Magnitude < 0.5 then
		return true
	end
	-- two rays (waist + knee height) so low obstacles count too
	local hit1 = workspace:Raycast(a, dir, losParams)
	local hit2 = workspace:Raycast(a - Vector3.new(0, 1.8, 0), dir, losParams)
	return hit1 == nil and hit2 == nil
end

local function newController(model)
	local c = controllers[model]
	if c then
		return c
	end
	c = {
		Model = model,
		Humanoid = model:FindFirstChildOfClass("Humanoid"),
		Root = model:FindFirstChild("HumanoidRootPart"),
		Mode = "None",
		Path = nil,
		Waypoints = nil,
		WpIndex = 0,
		PathBusy = false,
		PathAt = 0,
		LastProgressPos = nil,
		LastProgressAt = os.clock(),
		Accum = 0,
	}
	controllers[model] = c
	return c
end

-- Follow a leader (Player). offset = sideways offset so several followers fan out.
function NpcService.Follow(model, player, speed, offset)
	local c = newController(model)
	c.Humanoid.WalkSpeed = speed or Constants.NPC.FollowSpeed
	c.Offset = offset or 0
	if c.Mode == "Follow" and c.Leader == player then
		return -- already following them; just refresh speed/offset
	end
	c.Mode = "Follow"
	c.Leader = player
	c.Waypoints = nil
	c.LastProgressAt = os.clock()
end

-- Walk to a point, then call onArrive(model). onFail after `timeout` seconds.
function NpcService.WalkTo(model, point, speed, onArrive, timeout, onFail)
	local c = newController(model)
	c.Mode = "WalkTo"
	c.Target = point
	c.OnArrive = onArrive
	c.OnFail = onFail
	c.Deadline = os.clock() + (timeout or 30)
	c.Humanoid.WalkSpeed = speed or Constants.NPC.SeatSpeed
	c.Waypoints = nil
	c.LastProgressAt = os.clock()
end

-- Chase a player's character directly (front desk).
function NpcService.Chase(model, player, speed)
	local c = newController(model)
	c.Humanoid.WalkSpeed = speed or 16
	if c.Mode == "Chase" and c.Leader == player then
		return
	end
	c.Mode = "Chase"
	c.Leader = player
	c.Offset = 0
	c.Waypoints = nil
	c.LastProgressAt = os.clock()
end

function NpcService.Stop(model)
	local c = controllers[model]
	if c then
		c.Mode = "None"
		c.Waypoints = nil
		if c.Humanoid and c.Root and not c.Root.Anchored then
			c.Humanoid:MoveTo(c.Root.Position)
		end
	end
end

function NpcService.Forget(model)
	controllers[model] = nil
end

local function computePath(c, goal)
	if c.PathBusy then
		return
	end
	c.PathBusy = true
	local from = c.Root.Position
	task.spawn(function()
		local path = PathfindingService:CreatePath(AGENT)
		local ok = pcall(function()
			path:ComputeAsync(from, goal)
		end)
		c.PathBusy = false
		c.PathAt = os.clock()
		if ok and path.Status == Enum.PathStatus.Success then
			c.Waypoints = path:GetWaypoints()
			c.WpIndex = math.min(2, #c.Waypoints)
			c.PathGoal = goal
		else
			c.Waypoints = nil
		end
	end)
end

local function followWaypoints(c)
	local wps = c.Waypoints
	if not wps or c.WpIndex > #wps then
		return false
	end
	local wp = wps[c.WpIndex]
	if flat(wp.Position - c.Root.Position).Magnitude < 2.5 then
		c.WpIndex += 1
		wp = wps[c.WpIndex]
		if not wp then
			return false
		end
	end
	if wp.Action == Enum.PathWaypointAction.Jump then
		c.Humanoid.Jump = true
	end
	c.Humanoid:MoveTo(wp.Position)
	return true
end

-- Returns true when the NPC reached `goal` (XZ within arriveDist).
local function steer(c, goal, arriveDist)
	local pos = c.Root.Position
	local d = flat(goal - pos).Magnitude
	if d <= arriveDist then
		c.Humanoid:MoveTo(pos)
		c.Waypoints = nil
		return true
	end
	if math.abs(goal.Y - pos.Y) < 5 and hasLineOfSight(pos, goal) then
		c.Waypoints = nil
		c.Humanoid:MoveTo(goal)
	else
		local stale = not c.Waypoints
			or os.clock() - c.PathAt > 2
			or (c.PathGoal and (c.PathGoal - goal).Magnitude > 8)
		if stale then
			computePath(c, goal)
		end
		if not followWaypoints(c) then
			c.Humanoid:MoveTo(goal)
		end
	end

	-- stuck detection
	local now = os.clock()
	if not c.LastProgressPos or (pos - c.LastProgressPos).Magnitude > 1.2 then
		c.LastProgressPos = pos
		c.LastProgressAt = now
	elseif now - c.LastProgressAt > 1.4 then
		c.Humanoid.Jump = true
		c.Waypoints = nil
		if now - c.LastProgressAt > 5 then
			-- hopelessly stuck: hop a few studs toward the goal
			local dir = flat(goal - pos)
			if dir.Magnitude > 0.1 then
				c.Model:PivotTo(CFrame.new(pos + dir.Unit * math.min(6, dir.Magnitude) + Vector3.new(0, 2, 0)))
			end
			c.LastProgressAt = now
		end
	end
	return false
end

local function leaderRoot(c)
	local p = c.Leader
	local char = p and p.Parent and p.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hum and hum.Health > 0 then
		return hrp
	end
	return nil
end

function NpcService.GetLeaderRoot(model)
	local c = controllers[model]
	return c and leaderRoot(c)
end

function NpcService._step(dt)
	for model, set in pairs(animSets) do
		local hrp = model.Parent and model:FindFirstChild("HumanoidRootPart")
		if hrp and not hrp.Anchored then
			if not set.RayParams then
				set.RayParams = RaycastParams.new()
				set.RayParams.FilterType = Enum.RaycastFilterType.Exclude
				set.RayParams.FilterDescendantsInstances = { model }
			end
			updateLocomotion(set, hrp, dt)
		end
	end

	for model, c in pairs(controllers) do
		if not model.Parent or not c.Root or not c.Root.Parent then
			controllers[model] = nil
			continue
		end
		if c.Root.Anchored or c.Mode == "None" then
			continue
		end
		c.Accum += dt
		if c.Accum < 0.12 then
			continue
		end
		c.Accum = 0

		if c.Mode == "Follow" or c.Mode == "Chase" then
			local lr = leaderRoot(c)
			if lr then
				local look = flat(lr.CFrame.LookVector)
				look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
				local right = look:Cross(Vector3.yAxis)
				local goal
				local arrive
				if c.Mode == "Chase" then
					goal, arrive = lr.Position, 1
				else
					goal = lr.Position - look * Constants.NPC.FollowGap + right * c.Offset
					arrive = 2.2
				end
				local gap = flat(goal - c.Root.Position).Magnitude
				if gap > Constants.NPC.TeleportIfFartherThan then
					model:PivotTo(CFrame.new(goal + Vector3.new(0, 3, 0), goal + look))
					c.Waypoints = nil
				elseif steer(c, goal, arrive) and c.Mode == "Follow" then
					-- idle next to the leader: turn to face them
					local to = flat(lr.Position - c.Root.Position)
					if to.Magnitude > 0.5 then
						c.Root.CFrame = CFrame.lookAt(c.Root.Position, c.Root.Position + to)
					end
				end
			else
				c.Humanoid:MoveTo(c.Root.Position)
			end
		elseif c.Mode == "WalkTo" then
			if steer(c, c.Target, 1.6) then
				c.Mode = "None"
				local cb = c.OnArrive
				c.OnArrive, c.OnFail = nil, nil
				if cb then
					task.spawn(cb, model)
				end
			elseif os.clock() > c.Deadline then
				c.Mode = "None"
				local cb = c.OnFail
				c.OnArrive, c.OnFail = nil, nil
				if cb then
					task.spawn(cb, model)
				end
			end
		end
	end
end

return NpcService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="24">
      <Properties>
        <string name="Name">PlayerDataService</string>
        <string name="Source"><![CDATA[--[[
	PlayerDataService
	Owns the per-player profile, its persistence, leaderstats and the
	attribute mirror the client HUD reads from.

	PROFILE SCHEMA
	  Resets on rebirth : Cash, Placed
	  Permanent          : Strength, Rebirths, OwnedClothing, Equipped, Equipment, GymColor
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)

local PlayerDataService = {}

local cache = {} -- [userId] = profile
local store = nil

local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Constants.DATASTORE_NAME)
end)
if not storeOk then
	warn("[PlayerDataService] DataStore unavailable (unpublished place or API access off). Progress will not persist.")
end

local function key(userId)
	return "Player_" .. tostring(userId)
end

local function defaultProfile()
	return {
		Cash = 0,
		Strength = 0,
		Rebirths = 0,
		OwnedClothing = {}, -- [clothingId] = true
		Equipped = {}, -- [slotName] = clothingId
		Equipment = { RackSlots = 1, WorkoutGain = 1, DeskSpeed = 1 },
		GymColor = 3,
		Placed = {}, -- list of { Rarity = index, Name = string, Slot = number, Seed = number }
	}
end

local function mergeDefaults(data)
	local profile = defaultProfile()
	if type(data) ~= "table" then
		return profile
	end
	for k, v in pairs(data) do
		profile[k] = v
	end
	-- nested defaults
	for k, v in pairs(defaultProfile().Equipment) do
		if type(profile.Equipment) ~= "table" then
			profile.Equipment = {}
		end
		if profile.Equipment[k] == nil then
			profile.Equipment[k] = v
		end
	end
	if type(profile.OwnedClothing) ~= "table" then
		profile.OwnedClothing = {}
	end
	if type(profile.Equipped) ~= "table" then
		profile.Equipped = {}
	end
	if type(profile.Placed) ~= "table" then
		profile.Placed = {}
	end
	return profile
end

-- ----------------------------------------------------------------------
-- Sync helpers
-- ----------------------------------------------------------------------
function PlayerDataService.SyncLeaderstats(player)
	local profile = cache[player.UserId]
	local ls = player:FindFirstChild("leaderstats")
	if not profile or not ls then
		return
	end
	local cash = ls:FindFirstChild("Cash")
	local strength = ls:FindFirstChild("Strength")
	local rebirths = ls:FindFirstChild("Rebirths")
	if cash then
		cash.Value = math.floor(profile.Cash)
	end
	if strength then
		strength.Value = math.floor(profile.Strength)
	end
	if rebirths then
		rebirths.Value = profile.Rebirths
	end
end

function PlayerDataService.SyncAttributes(player)
	local profile = cache[player.UserId]
	if not profile then
		return
	end
	player:SetAttribute("OwnedClothing", HttpService:JSONEncode(profile.OwnedClothing))
	player:SetAttribute("Equipped", HttpService:JSONEncode(profile.Equipped))
	player:SetAttribute("Equipment", HttpService:JSONEncode(profile.Equipment))
	player:SetAttribute("GymColor", profile.GymColor)
	player:SetAttribute("RebirthThreshold", Constants.RebirthThreshold(profile.Rebirths))
	player:SetAttribute("RebirthMultiplier", Constants.RebirthMultiplier(profile.Rebirths))
end

-- ----------------------------------------------------------------------
-- Load / access
-- ----------------------------------------------------------------------
function PlayerDataService.LoadPlayer(player)
	local data = nil
	if store then
		local ok, err = pcall(function()
			data = store:GetAsync(key(player.UserId))
		end)
		if not ok then
			warn("[PlayerDataService] Load failed for " .. player.Name .. ": " .. tostring(err))
		end
	end

	local profile = mergeDefaults(data)
	cache[player.UserId] = profile

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cash = Instance.new("NumberValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats

	local strength = Instance.new("IntValue")
	strength.Name = "Strength"
	strength.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats

	leaderstats.Parent = player

	PlayerDataService.SyncLeaderstats(player)
	PlayerDataService.SyncAttributes(player)
	return profile
end

function PlayerDataService.GetProfile(userId)
	return cache[userId]
end

-- ----------------------------------------------------------------------
-- Mutators
-- ----------------------------------------------------------------------
function PlayerDataService.AddCash(player, delta)
	local profile = cache[player.UserId]
	if not profile then
		return 0
	end
	profile.Cash = math.max(0, profile.Cash + delta)
	PlayerDataService.SyncLeaderstats(player)
	return profile.Cash
end

function PlayerDataService.SetCash(player, value)
	local profile = cache[player.UserId]
	if not profile then
		return
	end
	profile.Cash = math.max(0, value)
	PlayerDataService.SyncLeaderstats(player)
end

function PlayerDataService.AddStrength(player, delta)
	local profile = cache[player.UserId]
	if not profile then
		return 0
	end
	profile.Strength = math.max(0, profile.Strength + delta)
	PlayerDataService.SyncLeaderstats(player)
	return profile.Strength
end

-- ----------------------------------------------------------------------
-- Save
-- ----------------------------------------------------------------------
function PlayerDataService.SaveData(player)
	local profile = cache[player.UserId]
	if not profile or not store then
		return
	end
	local snapshot = {
		Cash = profile.Cash,
		Strength = profile.Strength,
		Rebirths = profile.Rebirths,
		OwnedClothing = profile.OwnedClothing,
		Equipped = profile.Equipped,
		Equipment = profile.Equipment,
		GymColor = profile.GymColor,
		Placed = profile.Placed,
	}
	local ok, err = pcall(function()
		store:SetAsync(key(player.UserId), snapshot)
	end)
	if not ok then
		warn("[PlayerDataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
end

function PlayerDataService.SaveAll()
	for _, player in ipairs(Players:GetPlayers()) do
		PlayerDataService.SaveData(player)
	end
end

function PlayerDataService.Cleanup(player)
	cache[player.UserId] = nil
end

return PlayerDataService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="25">
      <Properties>
        <string name="Name">ShopService</string>
        <string name="Source"><![CDATA[--[[
	ShopService
	Server-authoritative purchases. The client only ever asks; the server
	validates Strength gates, Cash, and levels before changing anything.

	Remotes (RemoteFunction):
	  Purchase:InvokeServer(kind, id)   kind = "Clothing" | "Equipment" | "Booster"
	  Equip:InvokeServer(clothingId)    equips an OWNED clothing item into its slot
	  Rebirth:InvokeServer()
	Remote (RemoteEvent):
	  SetGymColor:FireServer(presetIndex)
]]

local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local EconomyService = require(SSS.EconomyService)
local InfluencerService = require(SSS.InfluencerService)
local Notify = require(SSS.Notify)

local ShopService = {}

local Remotes = RS:WaitForChild("Remotes")
local colorCooldown = {} -- [userId] = os.clock()

-- ----------------------------------------------------------------------
-- Clothing: Strength unlocks the RIGHT to buy. Cash is still required.
-- ----------------------------------------------------------------------
local function buyClothing(player, profile, id)
	local item = Constants.GetClothing(id)
	if not item then
		return false, "Unknown item."
	end
	if profile.OwnedClothing[id] then
		return false, "You already own " .. item.Name .. "."
	end
	if profile.Strength < item.Strength then
		return false, "Need " .. Constants.FormatNumber(item.Strength) .. " Strength to unlock " .. item.Name .. "."
	end
	if profile.Cash < item.Price then
		return false, "Need $" .. Constants.FormatNumber(item.Price) .. " for " .. item.Name .. "."
	end

	PlayerDataService.AddCash(player, -item.Price)
	profile.OwnedClothing[id] = true
	-- auto-equip if it beats (or fills) the current slot
	local currentId = profile.Equipped[item.Slot]
	local current = currentId and Constants.GetClothing(currentId)
	if not current or item.Bonus > current.Bonus then
		profile.Equipped[item.Slot] = id
	end
	PlayerDataService.SyncAttributes(player)
	return true, "Bought " .. item.Name .. "! +" .. math.floor(item.Bonus * 100) .. "% income"
end

local function equipClothing(player, profile, id)
	local item = Constants.GetClothing(id)
	if not item or not profile.OwnedClothing[id] then
		return false, "You don't own that."
	end
	profile.Equipped[item.Slot] = id
	PlayerDataService.SyncAttributes(player)
	return true, "Equipped " .. item.Name .. "."
end

-- ----------------------------------------------------------------------
-- Equipment: permanent, Cash-only
-- ----------------------------------------------------------------------
local function buyEquipment(player, profile, id)
	local def = Constants.EQUIPMENT[id]
	if not def then
		return false, "Unknown upgrade."
	end
	local level = profile.Equipment[id] or 1
	if level >= #def.Values then
		return false, def.Name .. " is maxed out."
	end
	local cost = def.Costs[level + 1]
	if profile.Cash < cost then
		return false, "Need $" .. Constants.FormatNumber(cost) .. " for the next " .. def.Name .. " level."
	end

	PlayerDataService.AddCash(player, -cost)
	profile.Equipment[id] = level + 1
	PlayerDataService.SyncAttributes(player)

	-- apply side effects immediately
	local plot = PlotService.GetPlotByOwner(player.UserId)
	if plot then
		if id == "RackSlots" then
			PlotService.RefreshSlots(plot.Id, def.Values[level + 1])
			player:SetAttribute("RackSlots", def.Values[level + 1])
		end
	end
	if ShopService.OnEquipmentChanged then
		ShopService.OnEquipmentChanged(player, id, level + 1)
	end
	return true, def.Name .. " upgraded to level " .. (level + 1) .. "!"
end

-- ----------------------------------------------------------------------
-- Boosters: temporary, Cash-only
-- ----------------------------------------------------------------------
local function buyBooster(player, profile, id)
	local b = Constants.GetBooster(id)
	if not b then
		return false, "Unknown booster."
	end
	if profile.Cash < b.Price then
		return false, "Need $" .. Constants.FormatNumber(b.Price) .. " for " .. b.Name .. "."
	end
	PlayerDataService.AddCash(player, -b.Price)
	EconomyService.ActivateBooster(player, b)
	return true, b.Name .. " active! " .. b.Desc
end

-- ----------------------------------------------------------------------
-- Rebirth: resets Cash + placed influencers ONLY.
-- Strength, clothing, equipment, gym color are permanent.
-- ----------------------------------------------------------------------
function ShopService.DoRebirth(player)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return false, "Profile not loaded."
	end
	local threshold = Constants.RebirthThreshold(profile.Rebirths)
	if profile.Cash < threshold then
		return false, "Need $" .. Constants.FormatNumber(threshold) .. " to rebirth."
	end

	-- drop anything in hand so nothing gets lost mid-carry
	InfluencerService.DropCarried(player)

	-- RESETS
	PlayerDataService.SetCash(player, 0)
	profile.Placed = {}
	local plot = PlotService.GetPlotByOwner(player.UserId)
	if plot then
		InfluencerService.ClearPlot(plot)
	end

	-- PERMANENT GAIN
	profile.Rebirths += 1
	PlayerDataService.SyncLeaderstats(player)
	PlayerDataService.SyncAttributes(player)

	local mult = Constants.RebirthMultiplier(profile.Rebirths)
	return true, string.format("REBIRTH %d! Permanent income x%.2f", profile.Rebirths, mult)
end

-- ----------------------------------------------------------------------
function ShopService.Init()
	Remotes.Purchase.OnServerInvoke = function(player, kind, id)
		local profile = PlayerDataService.GetProfile(player.UserId)
		if not profile or type(kind) ~= "string" or type(id) ~= "string" then
			return false, "Invalid request."
		end
		local ok, msg
		if kind == "Clothing" then
			ok, msg = buyClothing(player, profile, id)
		elseif kind == "Equipment" then
			ok, msg = buyEquipment(player, profile, id)
		elseif kind == "Booster" then
			ok, msg = buyBooster(player, profile, id)
		else
			ok, msg = false, "Invalid shop category."
		end
		Notify(player, msg, ok and "success" or "fail")
		return ok, msg
	end

	Remotes.Equip.OnServerInvoke = function(player, id)
		local profile = PlayerDataService.GetProfile(player.UserId)
		if not profile or type(id) ~= "string" then
			return false, "Invalid request."
		end
		local ok, msg = equipClothing(player, profile, id)
		Notify(player, msg, ok and "success" or "fail")
		return ok, msg
	end

	Remotes.Rebirth.OnServerInvoke = function(player)
		local ok, msg = ShopService.DoRebirth(player)
		Notify(player, msg, ok and "success" or "fail")
		return ok, msg
	end

	Remotes.SetGymColor.OnServerEvent:Connect(function(player, index)
		if type(index) ~= "number" or not Constants.GYM_COLORS[index] then
			return
		end
		local now = os.clock()
		if colorCooldown[player.UserId] and now - colorCooldown[player.UserId] < 0.5 then
			return
		end
		colorCooldown[player.UserId] = now
		local profile = PlayerDataService.GetProfile(player.UserId)
		local plot = PlotService.GetPlotByOwner(player.UserId)
		if not profile or not plot then
			return
		end
		profile.GymColor = index
		PlotService.ApplyColor(plot.Id, index)
		PlayerDataService.SyncAttributes(player)
	end)
end

function ShopService.ClearPlayer(player)
	colorCooldown[player.UserId] = nil
end

return ShopService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="26">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[--[[
	GYM WARS — server bootstrap
	Wires every service together and handles join / leave / respawn.
]]

local Players = game:GetService("Players")
local SSS = game:GetService("ServerScriptService")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local InfluencerService = require(SSS.InfluencerService)
local BeltService = require(SSS.BeltService)
local EconomyService = require(SSS.EconomyService)
local WorkoutService = require(SSS.WorkoutService)
local ShopService = require(SSS.ShopService)
local DefenseService = require(SSS.DefenseService)
local NpcService = require(SSS.NpcService)
local Notify = require(SSS.Notify)

-- ----------------------------------------------------------------------
-- Init order matters: plots first (everything hangs off them)
-- ----------------------------------------------------------------------
NpcService.Init()
PlotService.Init()
InfluencerService.Init()
DefenseService.Init()
BeltService.Init()
EconomyService.Init()
WorkoutService.Init()
ShopService.Init()

-- ----------------------------------------------------------------------
local function onCharacterAdded(player, character)
	-- players never collide with NPCs (influencers / front desk) so nobody gets body-blocked
	NpcService.SetGroup(character, NpcService.GROUP_PLAYERS)
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = NpcService.GROUP_PLAYERS
		end
	end)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.WalkSpeed = Constants.NORMAL_WALKSPEED
		humanoid.Died:Connect(function()
			InfluencerService.DropCarried(player)
		end)
	end
	player:SetAttribute("Stunned", false)
	player:SetAttribute("Carrying", "")

	local plot = PlotService.GetPlotByOwner(player.UserId)
	if plot then
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait() -- let the default spawn finish before moving
		PlotService.TeleportToPlot(player, plot)
	end
end

local function onPlayerAdded(player)
	local profile = PlayerDataService.LoadPlayer(player)
	local plot = PlotService.AssignPlot(player)

	if plot then
		local rackLevel = profile.Equipment.RackSlots or 1
		local slots = Constants.EQUIPMENT.RackSlots.Values[rackLevel]
		PlotService.RefreshSlots(plot.Id, slots)
		PlotService.ApplyColor(plot.Id, profile.GymColor or 3)
		local restored = InfluencerService.RestorePlaced(player, plot)
		player:SetAttribute("RackSlots", slots)
		player:SetAttribute("RackUsed", PlotService.CountPlaced(plot.Id))
		task.delay(3, function()
			if restored > 0 then
				Notify(player, "Welcome back! " .. restored .. " influencers are still training at your gym.", "success")
			else
				Notify(player, "Claim influencers off the red carpet and lead them to your gym!", "info")
			end
		end)
	else
		task.delay(3, function()
			Notify(player, "Server is full of gyms — you can still explore, but you need a gym to earn.", "fail")
		end)
	end

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

local function onPlayerRemoving(player)
	InfluencerService.DropCarried(player)

	local plot = PlotService.GetPlotByOwner(player.UserId)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if plot and profile then
		-- anything being lured out of this gym right now is gone for good
		for slot, rec in pairs(plot.Slots) do
			if rec and rec.State == "Following" then
				for i = #profile.Placed, 1, -1 do
					if profile.Placed[i].Slot == slot then
						table.remove(profile.Placed, i)
					end
				end
			end
		end
	end

	PlayerDataService.SaveData(player)

	if plot then
		InfluencerService.ClearPlot(plot)
		DefenseService.ResetPlot(plot)
		PlotService.ReleasePlot(player)
	end

	EconomyService.ClearPlayer(player)
	WorkoutService.ClearPlayer(player)
	ShopService.ClearPlayer(player)
	PlayerDataService.Cleanup(player)
end

RS.Remotes.DismissFollower.OnServerEvent:Connect(function(player)
	InfluencerService.DropCarried(player)
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- ----------------------------------------------------------------------
-- Autosave + shutdown save
-- ----------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(Constants.AUTOSAVE_INTERVAL)
		PlayerDataService.SaveAll()
	end
end)

game:BindToClose(function()
	PlayerDataService.SaveAll()
	task.wait(1)
end)

print("[GymWars] Server ready — " .. Constants.PLOT_COUNT .. " gyms, red carpet conveyor running.")
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="27">
      <Properties>
        <string name="Name">BeltService</string>
        <string name="Source"><![CDATA[--[[
	BeltService
	The shared conveyor down the middle of the map. The BeltTrack part is a real
	physics conveyor (its AssemblyLinearVelocity carries anything standing on
	it), so influencers ride it as physical characters and replicate smoothly.
	Spawns rarity-weighted influencers at BeltStart and removes whoever nobody
	claimed once they reach BeltEnd. Claiming is InfluencerService's prompt.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local InfluencerService = require(SSS.InfluencerService)
local Notify = require(SSS.Notify)

local BeltService = {}

local rng = Random.new()
local spawnTimer = 0
local track, startPart, endPart
local direction = Vector3.new(0, 0, 1)

function BeltService.Init()
	local belt = workspace:WaitForChild("GymWarsMap"):WaitForChild("Belt")
	track = belt:WaitForChild("BeltTrack")
	startPart = belt:WaitForChild("BeltStart")
	endPart = belt:WaitForChild("BeltEnd")
	direction = (endPart.Position - startPart.Position) * Vector3.new(1, 0, 1)
	direction = direction.Unit
	track.AssemblyLinearVelocity = direction * Constants.BELT.Speed
	track:SetAttribute("Speed", Constants.BELT.Speed)
	workspace:SetAttribute("BeltSpeed", Constants.BELT.Speed)

	RunService.Heartbeat:Connect(function(dt)
		BeltService.Step(dt)
	end)
end

local checkAccum = 0
function BeltService.Step(dt)
	local cfg = Constants.BELT
	-- keep the conveyor running (in case something reset it)
	if track.AssemblyLinearVelocity.Magnitude < 0.1 then
		track.AssemblyLinearVelocity = direction * cfg.Speed
	end

	checkAccum += dt
	if checkAccum >= 0.25 then
		checkAccum = 0
		local endDist = (endPart.Position - startPart.Position):Dot(direction)
		for _, rec in ipairs(InfluencerService.GetAllOnBelt()) do
			local rel = rec.Root.Position - startPart.Position
			local along = rel:Dot(direction)
			local lateral = (rel - direction * along) * Vector3.new(1, 0, 1)
			if along >= endDist then
				InfluencerService.Destroy(rec)
			elseif lateral.Magnitude > track.Size.X / 2 + 2 then
				InfluencerService.DropFromBelt(rec) -- fell off the side
			end
		end
	end

	spawnTimer += dt
	if spawnTimer >= cfg.SpawnInterval then
		spawnTimer = 0
		if InfluencerService.CountOnBelt() < cfg.MaxOnBelt then
			local rarityIdx = Constants.RollRarity(rng)
			local spawnCF = CFrame.new(startPart.Position + Vector3.new(rng:NextNumber(-0.8, 0.8), 0, 0))
			-- avatar creation can yield (asset loading), so don't block Heartbeat
			task.spawn(function()
				local rec = InfluencerService.Spawn(rarityIdx, spawnCF)
				if rarityIdx >= 4 then
					-- Epic / Legendary: let the whole server know
					local rarity = Constants.RARITIES[rarityIdx]
					for _, player in ipairs(Players:GetPlayers()) do
						Notify(player, rarity.Name:upper() .. " " .. rec.Name .. " just hit the red carpet!", "info")
					end
				end
			end)
		end
	end
end

return BeltService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="28">
      <Properties>
        <string name="Name">EconomyService</string>
        <string name="Source"><![CDATA[--[[
	EconomyService
	- Pays every plot owner once per second for the influencers on their rack.
	- Owns active boosters (timed buffs) and all multiplier math.

	income/sec = sum(placed influencer income)
	             * clothing multiplier   (1 + sum of equipped clothing bonuses)
	             * rebirth multiplier    (Constants.RebirthMultiplier)
	             * active Income boosters
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)

local EconomyService = {}

local activeBoosters = {} -- [userId] = { [boosterId] = expiresAt (os.time) }

-- ----------------------------------------------------------------------
-- Multipliers
-- ----------------------------------------------------------------------
function EconomyService.ClothingMultiplier(profile)
	local bonus = 0
	for _, id in pairs(profile.Equipped) do
		local item = Constants.GetClothing(id)
		if item and profile.OwnedClothing[id] then
			bonus += item.Bonus
		end
	end
	return 1 + bonus
end

function EconomyService.BoosterMultiplier(userId, effect)
	local mult = 1
	local list = activeBoosters[userId]
	if not list then
		return mult
	end
	local now = os.time()
	for id, expires in pairs(list) do
		if expires > now then
			local b = Constants.GetBooster(id)
			if b and b.Effect == effect then
				mult *= b.Multiplier
			end
		end
	end
	return mult
end

function EconomyService.IncomeMultiplier(player)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return 1
	end
	return EconomyService.ClothingMultiplier(profile)
		* Constants.RebirthMultiplier(profile.Rebirths)
		* EconomyService.BoosterMultiplier(player.UserId, "Income")
end

function EconomyService.BaseIncome(plot)
	local total = 0
	for _, rec in pairs(plot.Slots) do
		if rec and rec.State == "Placed" then
			total += rec.Income
		end
	end
	return total
end

-- ----------------------------------------------------------------------
-- Boosters
-- ----------------------------------------------------------------------
local function syncBoosterAttr(player)
	local list = activeBoosters[player.UserId] or {}
	local out = {}
	local now = os.time()
	for id, expires in pairs(list) do
		if expires > now then
			out[id] = expires
		end
	end
	player:SetAttribute("Boosters", HttpService:JSONEncode(out))
end

function EconomyService.ActivateBooster(player, booster)
	activeBoosters[player.UserId] = activeBoosters[player.UserId] or {}
	local now = os.time()
	local current = activeBoosters[player.UserId][booster.Id]
	-- buying again while active refreshes (does not stack duration past one full timer from now)
	local base = (current and current > now) and current or now
	activeBoosters[player.UserId][booster.Id] = math.min(base + booster.Duration, now + booster.Duration * 2)
	syncBoosterAttr(player)
end

function EconomyService.ClearPlayer(player)
	activeBoosters[player.UserId] = nil
end

-- ----------------------------------------------------------------------
-- Tick
-- ----------------------------------------------------------------------
function EconomyService.Init()
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for _, player in ipairs(Players:GetPlayers()) do
				local plot = PlotService.GetPlotByOwner(player.UserId)
				if plot then
					local base = EconomyService.BaseIncome(plot)
					local mult = EconomyService.IncomeMultiplier(player)
					local perSec = base * mult
					if perSec > 0 then
						PlayerDataService.AddCash(player, perSec)
					end
					player:SetAttribute("IncomePerSec", perSec)
					player:SetAttribute("IncomeMultiplier", mult)
				end

				-- expire boosters
				local list = activeBoosters[player.UserId]
				if list then
					local changed = false
					for id, expires in pairs(list) do
						if expires <= now then
							list[id] = nil
							changed = true
						end
					end
					if changed then
						syncBoosterAttr(player)
					end
				end
			end
		end
	end)
end

return EconomyService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="29">
      <Properties>
        <string name="Name">InfluencerService</string>
        <string name="Source"><![CDATA[--[[
	InfluencerService
	Owns every influencer NPC (a real R15 character) and its lifecycle:

	  OnBelt    -> standing on the conveyor, riding it (claimable by anyone)
	  Following -> walking behind the player who claimed them, slower than the
	               player (Constants.NPC.FollowSpeed), pathfinding around walls
	  Seating   -> inside the owner's gym, walking to their machine
	  Placed    -> training on a machine (anchored; clients animate the workout),
	               earning Cash for the plot owner
	  Returning -> walking back to their machine after the front desk caught a thief
	  Dropped   -> standing around unowned (leader died/left), claimable, leaves later

	Stealing: grabbing a Placed influencer in someone else's gym makes it follow
	the thief with OriginPlotId/OriginSlot remembered. If the thief is caught it
	walks back to its machine; if it reaches the thief's gym it becomes theirs.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local NpcService = require(SSS.NpcService)
local Notify = require(SSS.Notify)

local InfluencerService = {}

-- Callbacks set by DefenseService
InfluencerService.OnTheftStarted = nil -- function(rec, thiefPlayer, victimPlot)
InfluencerService.OnTheftEnded = nil -- function(rec, victimPlot)

local records = {} -- [model] = rec
local carriedBy = {} -- [userId] = rec  (the influencer following that player)
local rackFullDebounce = {} -- [userId] = os.clock()
local folder = nil
local rng = Random.new()

-- ----------------------------------------------------------------------
-- Model construction
-- ----------------------------------------------------------------------
local function looksFor(rec)
	local r = Random.new(rec.Seed)
	local rarity = Constants.RARITIES[rec.Rarity]
	local tier = rec.Rarity - 1
	return {
		Name = rec.Name,
		Skin = Constants.SKIN_TONES[r:NextInteger(1, #Constants.SKIN_TONES)],
		Shirt = rarity.Color,
		Pants = Color3.fromRGB(28 + r:NextInteger(0, 20), 30 + r:NextInteger(0, 20), 38 + r:NextInteger(0, 24)),
		Height = 1 + r:NextNumber(0, 0.06) + tier * 0.01,
		Width = 1 + r:NextNumber(0, 0.06) + tier * 0.05,
		Depth = 1 + r:NextNumber(0, 0.05) + tier * 0.04,
		AvatarUserId = Constants.INFLUENCER_AVATARS[rec.Name],
	}
end

local function buildModel(rec)
	local rarity = Constants.RARITIES[rec.Rarity]
	local model = NpcService.CreateRig(looksFor(rec))
	local root = model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head") or root

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.new(0, 170, 0, 46)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 90
	tag.LightInfluence = 0
	tag.Parent = head

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = rec.Name
	nameLabel.Parent = tag

	local rarityLabel = Instance.new("TextLabel")
	rarityLabel.Name = "RarityLabel"
	rarityLabel.Size = UDim2.new(1, 0, 0.4, 0)
	rarityLabel.Position = UDim2.new(0, 0, 0.6, 0)
	rarityLabel.BackgroundTransparency = 1
	rarityLabel.Font = Enum.Font.GothamBold
	rarityLabel.TextScaled = true
	rarityLabel.TextColor3 = rarity.Color
	rarityLabel.TextStrokeTransparency = 0.3
	rarityLabel.Text = rarity.Name .. "  +$" .. Constants.FormatNumber(rec.Income) .. "/s"
	rarityLabel.Parent = tag

	if rec.Rarity >= 4 then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = rarity.Color
		sparkle.Parent = root
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GrabPrompt"
	prompt.ActionText = "Claim"
	prompt.ObjectText = rec.Name
	prompt.HoldDuration = Constants.BELT.ClaimHold
	prompt.MaxActivationDistance = Constants.BELT.ClaimDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	local stationRef = Instance.new("ObjectValue")
	stationRef.Name = "Station"
	stationRef.Parent = model

	model:SetAttribute("Rarity", rec.Rarity)
	model:SetAttribute("Income", rec.Income)
	model:SetAttribute("Seed", rec.Seed)
	model:SetAttribute("State", rec.State)
	model:SetAttribute("OwnerUserId", 0)

	rec.Model = model
	rec.Root = root
	rec.Humanoid = model:FindFirstChildOfClass("Humanoid")
	rec.Prompt = prompt
	rec.StationRef = stationRef
	records[model] = rec

	prompt.Triggered:Connect(function(player)
		InfluencerService.OnGrab(player, rec)
	end)
	return model
end

local function setState(rec, state)
	rec.State = state
	if rec.Model then
		rec.Model:SetAttribute("State", state)
		if rec.Prompt then
			rec.Prompt.Enabled = state == "OnBelt" or state == "Dropped" or state == "Placed"
			rec.Prompt.ActionText = state == "Placed" and "Steal" or "Claim"
		end
	end
end

local function setAnchored(rec, anchored)
	if rec.Root then
		rec.Root.Anchored = anchored
		if rec.Humanoid then
			rec.Humanoid.PlatformStand = anchored
		end
		if not anchored then
			NpcService.Activate(rec.Model)
		end
	end
end

-- ----------------------------------------------------------------------
-- Profile helpers (persist placed influencers)
-- ----------------------------------------------------------------------
local function removeFromProfile(player, slot)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return
	end
	for i = #profile.Placed, 1, -1 do
		if profile.Placed[i].Slot == slot then
			table.remove(profile.Placed, i)
		end
	end
end

local function addToProfile(player, rec)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return
	end
	removeFromProfile(player, rec.Slot)
	table.insert(profile.Placed, { Rarity = rec.Rarity, Name = rec.Name, Slot = rec.Slot, Seed = rec.Seed })
end

local function refreshRackAttr(plot)
	local owner = PlotService.GetOwnerPlayer(plot)
	if owner then
		owner:SetAttribute("RackUsed", PlotService.CountPlaced(plot.Id))
		owner:SetAttribute("RackSlots", plot.Unlocked)
	end
end

-- ----------------------------------------------------------------------
-- Following (the old "carry")
-- ----------------------------------------------------------------------
local function setWalkSpeed(player, speed)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and not player:GetAttribute("Stunned") then
		humanoid.WalkSpeed = speed
	end
end

local function hopOffBelt(rec)
	-- step off the conveyor rails with a little hop
	if rec.Humanoid then
		rec.Humanoid.Jump = true
	end
end

-- Get off a machine: stand upright at the machine's approach point, unanchored.
local function standUp(rec)
	local station = rec.StationRef.Value
	local approach = station and station:FindFirstChild("Approach")
	local pos = approach and approach.Position or rec.Root.Position
	local look = rec.Root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.1 then
		look = Vector3.new(0, 0, -1)
	end
	rec.Model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 3.2, 0), pos + Vector3.new(0, 3.2, 0) + look.Unit))
	setAnchored(rec, false)
	NpcService.SetAnimationsEnabled(rec.Model, true)
	rec.StationRef.Value = nil
end

local function startFollow(player, rec)
	local wasOnBelt = rec.State == "OnBelt"
	if rec.Root.Anchored then
		standUp(rec)
	end
	setWalkSpeed(player, Constants.CARRY_WALKSPEED)
	setState(rec, "Following")
	rec.CarrierUserId = player.UserId
	rec.Model:SetAttribute("OwnerUserId", player.UserId)
	carriedBy[player.UserId] = rec
	player:SetAttribute("Carrying", rec.Name)
	NpcService.Follow(rec.Model, player, Constants.NPC.FollowSpeed, 0)
	if wasOnBelt then
		hopOffBelt(rec)
	end
end

local function endFollow(rec)
	local uid = rec.CarrierUserId
	if uid then
		if carriedBy[uid] == rec then
			carriedBy[uid] = nil
		end
		local player = Players:GetPlayerByUserId(uid)
		if player then
			player:SetAttribute("Carrying", "")
			setWalkSpeed(player, Constants.NORMAL_WALKSPEED)
		end
	end
	rec.CarrierUserId = nil
	if rec.Model then
		NpcService.Stop(rec.Model)
	end
end

-- Anchor the NPC on its machine; clients take over and animate the workout.
local function sitOnStation(rec, plot, slot, timeOffset)
	local station = PlotService.GetStation(plot.Id, slot)
	setState(rec, "Placed")
	rec.PlotId = plot.Id
	rec.Slot = slot
	plot.Slots[slot] = rec
	NpcService.Stop(rec.Model)
	NpcService.SetAnimationsEnabled(rec.Model, false)
	if station then
		local rider = station:FindFirstChild("Rider")
		setAnchored(rec, true)
		rec.Root.CFrame = rider and rider.CFrame or station:GetPivot()
		rec.StationRef.Value = station
	end
	rec.Model:SetAttribute("OwnerUserId", plot.OwnerUserId)
	-- clients animate from this timestamp (offset = start mid-workout, e.g. after a rejoin)
	rec.Model:SetAttribute("SeatedAt", workspace:GetServerTimeNow() - (timeOffset or 0))
	refreshRackAttr(plot)
end

-- Walk to the machine's approach point, then hop on.
local function walkToStation(rec, plot, slot, speed, state)
	local station = PlotService.GetStation(plot.Id, slot)
	setState(rec, state or "Seating")
	rec.PlotId = plot.Id
	rec.Slot = slot
	plot.Slots[slot] = rec -- reserve the slot right away
	rec.Model:SetAttribute("OwnerUserId", plot.OwnerUserId)
	refreshRackAttr(plot)
	local approach = station and station:FindFirstChild("Approach")
	if not approach then
		sitOnStation(rec, plot, slot)
		return
	end
	local token = {}
	rec.SeatToken = token
	local function arrive()
		if rec.SeatToken == token and rec.Model and plot.Slots[slot] == rec then
			sitOnStation(rec, plot, slot)
		end
	end
	NpcService.WalkTo(rec.Model, approach.Position, speed or Constants.NPC.SeatSpeed, arrive, Constants.NPC.SeatTimeout, arrive)
end

local function dropHere(rec)
	setState(rec, "Dropped")
	rec.PlotId = nil
	rec.Slot = nil
	rec.DroppedAt = os.clock()
	rec.Model:SetAttribute("OwnerUserId", 0)
	if rec.Root.Anchored then
		standUp(rec)
	end
	rec.StationRef.Value = nil
	NpcService.Stop(rec.Model)
end

-- ----------------------------------------------------------------------
-- Public: spawning / destroying
-- ----------------------------------------------------------------------
function InfluencerService.Init()
	folder = workspace:FindFirstChild("Influencers")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Influencers"
		folder.Parent = workspace
	end

	RunService.Heartbeat:Connect(function(dt)
		InfluencerService.Update(dt)
	end)
end

local function newRecord(rarityIdx, name, seed, state)
	local rarity = Constants.RARITIES[rarityIdx] or Constants.RARITIES[1]
	return {
		Rarity = rarityIdx,
		Name = name or rarity.Names[rng:NextInteger(1, #rarity.Names)],
		Income = rarity.Income,
		Seed = seed or rng:NextInteger(1, 2 ^ 30),
		State = state,
	}
end

-- Spawn a new influencer on the belt at `spawnCF` (facing sideways, toward the gyms).
function InfluencerService.Spawn(rarityIdx, spawnCF)
	local rec = newRecord(rarityIdx, nil, nil, "OnBelt")
	local model = buildModel(rec)
	setState(rec, "OnBelt")
	local side = rng:NextNumber() < 0.5 and 1 or -1
	local pos = spawnCF.Position
	model:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(side, 0, 0)))
	model.Parent = folder
	NpcService.Activate(model)
	return rec
end

function InfluencerService.Destroy(rec)
	if not rec or not rec.Model then
		return
	end
	if rec.CarrierUserId then
		endFollow(rec)
	end
	if rec.PlotId and rec.Slot then
		local plot = PlotService.GetPlotById(rec.PlotId)
		if plot and plot.Slots[rec.Slot] == rec then
			plot.Slots[rec.Slot] = nil
			refreshRackAttr(plot)
		end
	end
	if rec.OriginPlotId and rec.OriginSlot then
		local plot = PlotService.GetPlotById(rec.OriginPlotId)
		if plot and plot.Slots[rec.OriginSlot] == rec then
			plot.Slots[rec.OriginSlot] = nil
			refreshRackAttr(plot)
		end
	end
	NpcService.Forget(rec.Model)
	records[rec.Model] = nil
	rec.Model:Destroy()
	rec.Model = nil
end

function InfluencerService.GetAllOnBelt()
	local list = {}
	for _, rec in pairs(records) do
		if rec.State == "OnBelt" then
			table.insert(list, rec)
		end
	end
	return list
end

function InfluencerService.CountOnBelt()
	local n = 0
	for _, rec in pairs(records) do
		if rec.State == "OnBelt" then
			n += 1
		end
	end
	return n
end

-- ----------------------------------------------------------------------
-- Public: grabbing (claim or steal)
-- ----------------------------------------------------------------------
function InfluencerService.OnGrab(player, rec)
	if not rec.Model then
		return
	end
	local uid = player.UserId
	if player:GetAttribute("Stunned") then
		return
	end
	-- server-side range check (prompts are client-evaluated)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or (hrp.Position - rec.Root.Position).Magnitude > Constants.BELT.ClaimDistance + 6 then
		return
	end
	if not PlotService.GetPlotByOwner(uid) then
		Notify(player, "All gyms are taken — you need a gym to hold influencers.", "fail")
		return
	end

	if rec.State == "OnBelt" or rec.State == "Dropped" then
		if carriedBy[uid] then
			Notify(player, "Someone is already following you! Get them to your gym first.", "fail")
			return
		end
		startFollow(player, rec)
		Notify(player, rec.Name .. " is following you! Lead them to your gym.", "success")
		return
	end

	if rec.State == "Placed" then
		local plot = PlotService.GetPlotById(rec.PlotId)
		if not plot then
			return
		end
		if plot.OwnerUserId == uid then
			Notify(player, rec.Name .. " is already training at your gym.", "info")
			return
		end
		if carriedBy[uid] then
			Notify(player, "Someone is already following you!", "fail")
			return
		end
		-- THEFT: keep the origin slot reserved so it can return if the thief is caught
		rec.OriginPlotId = plot.Id
		rec.OriginSlot = rec.Slot
		rec.PlotId = nil
		rec.Slot = nil
		startFollow(player, rec)
		refreshRackAttr(plot)

		local victim = PlotService.GetOwnerPlayer(plot)
		Notify(player, "You lured " .. rec.Name .. " away! Get them to YOUR gym before the front desk catches you!", "info")
		if victim then
			Notify(victim, player.DisplayName .. " is stealing your " .. rec.Name .. "!", "fail")
		end
		if InfluencerService.OnTheftStarted then
			InfluencerService.OnTheftStarted(rec, player, plot)
		end
	end
end

function InfluencerService.GetCarried(player)
	return carriedBy[player.UserId]
end

function InfluencerService.GetCarrierPlayer(rec)
	return rec.CarrierUserId and Players:GetPlayerByUserId(rec.CarrierUserId) or nil
end

-- ----------------------------------------------------------------------
-- Public: placing / dropping / returning
-- ----------------------------------------------------------------------
-- The follower walked into its leader's gym: claim a slot and walk to the machine.
function InfluencerService.Place(rec, plot, slot, ownerPlayer)
	if rec.OriginPlotId then
		local originPlot = PlotService.GetPlotById(rec.OriginPlotId)
		if originPlot then
			if originPlot.Slots[rec.OriginSlot] == rec then
				originPlot.Slots[rec.OriginSlot] = nil
			end
			local victim = PlotService.GetOwnerPlayer(originPlot)
			if victim then
				removeFromProfile(victim, rec.OriginSlot)
				Notify(victim, (ownerPlayer and ownerPlayer.DisplayName or "Someone") .. " stole your " .. rec.Name .. "!", "fail")
			end
			refreshRackAttr(originPlot)
			if InfluencerService.OnTheftEnded then
				InfluencerService.OnTheftEnded(rec, originPlot)
			end
		end
		rec.OriginPlotId = nil
		rec.OriginSlot = nil
	end

	endFollow(rec)
	walkToStation(rec, plot, slot)

	local owner = ownerPlayer or PlotService.GetOwnerPlayer(plot)
	if owner then
		addToProfile(owner, rec)
		local station = PlotService.GetStation(plot.Id, slot)
		local what = station and PlotService.StationName(station) or "a machine"
		Notify(owner, rec.Name .. " is heading to the " .. what .. "! +$" .. Constants.FormatNumber(rec.Income) .. "/s", "success")
	end
end

-- Thief caught: walk back to the original machine.
function InfluencerService.ReturnToOrigin(rec)
	local originPlot = rec.OriginPlotId and PlotService.GetPlotById(rec.OriginPlotId)
	local originSlot = rec.OriginSlot
	rec.OriginPlotId = nil
	rec.OriginSlot = nil
	endFollow(rec)

	if originPlot and originPlot.OwnerUserId ~= 0 and originPlot.Slots[originSlot] == rec then
		walkToStation(rec, originPlot, originSlot, Constants.NPC.ReturnSpeed, "Returning")
	else
		dropHere(rec)
	end
	if InfluencerService.OnTheftEnded and originPlot then
		InfluencerService.OnTheftEnded(rec, originPlot)
	end
end

-- Knocked off the conveyor: stand around (claimable) and leave after a while.
function InfluencerService.DropFromBelt(rec)
	if rec.Model and rec.State == "OnBelt" then
		dropHere(rec)
	end
end

-- Leader died / left / rebirthed / dismissed.
function InfluencerService.DropCarried(player)
	local rec = carriedBy[player.UserId]
	if not rec then
		return
	end
	if rec.OriginPlotId then
		InfluencerService.ReturnToOrigin(rec)
	else
		endFollow(rec)
		dropHere(rec)
	end
end

-- Destroys every influencer placed on / walking to a plot (does NOT touch the profile).
function InfluencerService.ClearPlot(plot)
	for slot, rec in pairs(plot.Slots) do
		if rec and rec.Model and (rec.State == "Placed" or rec.State == "Seating" or rec.State == "Returning") then
			InfluencerService.Destroy(rec)
		end
		plot.Slots[slot] = nil
	end
	refreshRackAttr(plot)
end

-- Rebuilds a player's saved gym when they join.
function InfluencerService.RestorePlaced(player, plot)
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return 0
	end
	local restored = 0
	for _, entry in ipairs(profile.Placed) do
		local slot = entry.Slot
		if slot and slot <= plot.Unlocked and not plot.Slots[slot] and Constants.RARITIES[entry.Rarity] then
			local rec = newRecord(entry.Rarity, entry.Name or Constants.RARITIES[entry.Rarity].Names[1], entry.Seed, "Placed")
			entry.Seed = rec.Seed
			local model = buildModel(rec)
			model.Parent = folder
			sitOnStation(rec, plot, slot, rng:NextNumber(0, 30))
			restored += 1
		end
	end
	return restored
end

-- ----------------------------------------------------------------------
-- Heartbeat
-- ----------------------------------------------------------------------
local tickAccum = 0
local despawnAccum = 0
local emoteAccum = 0

local function checkArrivedHome(player, rec)
	local plot = PlotService.GetPlotByOwner(player.UserId)
	if not plot or not PlotService.IsInsideGym(plot, rec.Root.Position) then
		return
	end
	local slot = PlotService.FindOpenSlot(plot.Id)
	if not slot then
		local now = os.clock()
		if not rackFullDebounce[player.UserId] or now - rackFullDebounce[player.UserId] > 4 then
			rackFullDebounce[player.UserId] = now
			Notify(player, "Every unlocked machine is taken! Upgrade Rack Slots in the Shop.", "fail")
		end
		return
	end
	InfluencerService.Place(rec, plot, slot, player)
end

function InfluencerService.Update(dt)
	tickAccum += dt
	if tickAccum >= 0.2 then
		tickAccum = 0
		for uid, rec in pairs(carriedBy) do
			local player = Players:GetPlayerByUserId(uid)
			local character = player and player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not rec.Model then
				carriedBy[uid] = nil
			elseif player and humanoid and humanoid.Health > 0 then
				checkArrivedHome(player, rec)
			elseif player then
				InfluencerService.DropCarried(player)
			else
				endFollow(rec)
				dropHere(rec)
			end
		end
		-- fell off the world?
		for _, rec in pairs(records) do
			if rec.Root and rec.Root.Position.Y < -40 then
				if rec.State == "Following" and rec.CarrierUserId then
					local lr = NpcService.GetLeaderRoot(rec.Model)
					if lr then
						rec.Model:PivotTo(lr.CFrame * CFrame.new(0, 2, 5))
					end
				else
					task.defer(InfluencerService.Destroy, rec)
				end
			end
		end
	end

	-- belt riders show off now and then
	emoteAccum += dt
	if emoteAccum >= 1 then
		emoteAccum = 0
		for _, rec in pairs(records) do
			if rec.State == "OnBelt" and rng:NextNumber() < Constants.NPC.EmoteChance then
				NpcService.PlayEmote(rec.Model, NpcService.EMOTES[rng:NextInteger(1, #NpcService.EMOTES)])
			end
		end
	end

	-- dropped: leave after a while (checked ~once per second)
	despawnAccum += dt
	if despawnAccum >= 1 then
		despawnAccum = 0
		local now = os.clock()
		for _, rec in pairs(records) do
			if rec.State == "Dropped" and rec.DroppedAt and now - rec.DroppedAt > Constants.BELT.DroppedDespawn then
				task.defer(InfluencerService.Destroy, rec)
			end
		end
	end
end

return InfluencerService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="30">
      <Properties>
        <string name="Name">WorkoutService</string>
        <string name="Source"><![CDATA[--[[
	WorkoutService
	Each plot's WorkoutStation has a ProximityPrompt. Only the owner can use
	their own station. Each rep adds Strength (permanent, never reset):
	  gain = BaseGain * WorkoutGain equipment value
	Rep cooldown is divided by active WorkoutSpeed boosters (Creatine).
]]

local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local EconomyService = require(SSS.EconomyService)
local Notify = require(SSS.Notify)

local WorkoutService = {}

local lastRep = {} -- [userId] = os.clock()

local function doRep(player, plot)
	if plot.OwnerUserId ~= player.UserId then
		Notify(player, "That's not your gym! Go lift at your own station.", "fail")
		return
	end
	local profile = PlayerDataService.GetProfile(player.UserId)
	if not profile then
		return
	end

	local speed = EconomyService.BoosterMultiplier(player.UserId, "WorkoutSpeed")
	local cooldown = Constants.WORKOUT.RepCooldown / speed
	local now = os.clock()
	if lastRep[player.UserId] and now - lastRep[player.UserId] < cooldown then
		return
	end
	lastRep[player.UserId] = now

	local level = profile.Equipment.WorkoutGain or 1
	local gainPerRep = Constants.EQUIPMENT.WorkoutGain.Values[level] or 1
	PlayerDataService.AddStrength(player, Constants.WORKOUT.BaseGain * gainPerRep)
end

function WorkoutService.Init()
	for _, plot in pairs(PlotService.GetAllPlots()) do
		local station = plot.Model:FindFirstChild("WorkoutStation")
		if station then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "WorkoutPrompt"
			prompt.ActionText = "Do a Rep"
			prompt.ObjectText = "Heavy Bag"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = Constants.WORKOUT.PromptDistance
			prompt.RequiresLineOfSight = false
			prompt.KeyboardKeyCode = Enum.KeyCode.E
			prompt.Parent = station

			prompt.Triggered:Connect(function(player)
				doRep(player, plot)
			end)
		end
	end
end

function WorkoutService.ClearPlayer(player)
	lastRep[player.UserId] = nil
end

return WorkoutService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="31">
      <Properties>
        <string name="Name">Notify</string>
        <string name="Source"><![CDATA[-- Tiny helper: send a toast to one player's HUD.
-- kind: "info" | "success" | "fail"
local RS = game:GetService("ReplicatedStorage")
local NotifyRemote = RS:WaitForChild("Remotes"):WaitForChild("Notify")

return function(player, text, kind)
	if player and player.Parent then
		NotifyRemote:FireClient(player, { Text = text, Kind = kind or "info" })
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="32">
      <Properties>
        <string name="Name">PlotService</string>
        <string name="Source"><![CDATA[--[[
	PlotService
	Assigns the 10 gym lots to players, handles sign text, gym colors,
	station unlock visuals and teleporting players home.

	Each plot model (GymWarsMap.Plots.PlotN) contains:
	  Floor, WallBack/WallLeft/WallRight, Sign, FrontDesk, DeskSpawn, PlotSpawn,
	  WorkoutStation (owner's heavy bag), GymZone (interior volume),
	  Stations/Station1..Station12 (see tools/map/Stations.luau)
	Parts tagged with the "ColorRole" attribute ("Wall" / "Accent" / "AccentDim")
	are recolored by the owner's gym color preset.
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Constants = require(RS.Modules.Constants)
local StationSpecs = require(RS.Modules.Gym.StationSpecs)

local PlotService = {}

local plots = {} -- [plotId] = plot record
local ownerToPlot = {} -- [userId] = plotId

local DEFAULT_COLOR = 3 -- "Ice" (blue accents, like the reference gym)
local LOCKED_COLOR = Color3.fromRGB(28, 30, 38)
local OPEN_COLOR = Color3.fromRGB(90, 220, 150)

-- ----------------------------------------------------------------------
local function makeSignGui(signPart)
	local gui = signPart:FindFirstChild("SignGui")
	if gui then
		return gui
	end
	gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = signPart

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = "OPEN GYM"
	label.Parent = gui
	return gui
end

local function lockTag(pad)
	local tag = pad:FindFirstChild("LockTag")
	if tag then
		return tag
	end
	tag = Instance.new("BillboardGui")
	tag.Name = "LockTag"
	tag.Size = UDim2.new(0, 150, 0, 40)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
	tag.MaxDistance = 45
	tag.LightInfluence = 0
	tag.Parent = pad
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.3
	label.Parent = tag
	return tag
end

-- ----------------------------------------------------------------------
function PlotService.Init()
	local folder = workspace:WaitForChild("GymWarsMap"):WaitForChild("Plots")
	for i = 1, Constants.PLOT_COUNT do
		local model = folder:FindFirstChild("Plot" .. i)
		if model then
			model:SetAttribute("PlotId", i)
			model:SetAttribute("OwnerUserId", 0)
			local plot = {
				Id = i,
				Model = model,
				OwnerUserId = 0,
				Slots = {}, -- [slotIndex] = influencer record
				Unlocked = 0,
				Stations = {},
				Roles = { Wall = {}, Accent = {}, AccentDim = {} },
			}
			local stations = model:FindFirstChild("Stations")
			for k = 1, Constants.RACK_SLOT_MAX do
				plot.Stations[k] = stations and stations:FindFirstChild("Station" .. k)
			end
			for _, d in ipairs(model:GetDescendants()) do
				local role = d:IsA("BasePart") and d:GetAttribute("ColorRole")
				if role and plot.Roles[role] then
					table.insert(plot.Roles[role], d)
				end
			end
			plots[i] = plot
			makeSignGui(model:WaitForChild("Sign"))
			PlotService.SetSignText(i, "OPEN GYM")
			PlotService.ApplyColor(i, DEFAULT_COLOR)
			PlotService.RefreshSlots(i, 0)
		else
			warn("[PlotService] Missing Plot" .. i .. " in GymWarsMap.Plots")
		end
	end
end

function PlotService.GetPlotById(id)
	return plots[id]
end

function PlotService.GetPlotByOwner(userId)
	local id = ownerToPlot[userId]
	return id and plots[id] or nil
end

function PlotService.GetAllPlots()
	return plots
end

function PlotService.GetStation(plotId, slot)
	local plot = plots[plotId]
	return plot and plot.Stations[slot] or nil
end

function PlotService.StationName(station)
	local kind = station:GetAttribute("Exercise")
	return StationSpecs.DISPLAY_NAMES[kind] or kind or "machine"
end

-- Walk up from any instance to find which plot it belongs to.
function PlotService.GetPlotFromInstance(inst)
	local node = inst
	while node and node ~= workspace do
		local id = node:GetAttribute("PlotId")
		if id then
			return plots[id]
		end
		node = node.Parent
	end
	return nil
end

function PlotService.IsInsideGym(plot, point)
	local zone = plot and plot.Model:FindFirstChild("GymZone")
	if not zone then
		return false
	end
	local rel = zone.CFrame:PointToObjectSpace(point)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

-- ----------------------------------------------------------------------
function PlotService.AssignPlot(player)
	if ownerToPlot[player.UserId] then
		return plots[ownerToPlot[player.UserId]]
	end
	for i = 1, Constants.PLOT_COUNT do
		local plot = plots[i]
		if plot and plot.OwnerUserId == 0 then
			plot.OwnerUserId = player.UserId
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			ownerToPlot[player.UserId] = i
			player:SetAttribute("PlotId", i)
			PlotService.SetSignText(i, player.DisplayName .. "'s Gym")
			return plot
		end
	end
	return nil
end

function PlotService.ReleasePlot(player)
	local id = ownerToPlot[player.UserId]
	if not id then
		return
	end
	local plot = plots[id]
	plot.OwnerUserId = 0
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.Slots = {}
	ownerToPlot[player.UserId] = nil
	PlotService.SetSignText(id, "OPEN GYM")
	PlotService.ApplyColor(id, DEFAULT_COLOR)
	PlotService.RefreshSlots(id, 0)
end

-- ----------------------------------------------------------------------
function PlotService.SetSignText(plotId, text)
	local plot = plots[plotId]
	local sign = plot and plot.Model:FindFirstChild("Sign")
	local gui = sign and sign:FindFirstChild("SignGui")
	local label = gui and gui:FindFirstChild("Label")
	if label then
		label.Text = text
	end
end

function PlotService.ApplyColor(plotId, presetIndex)
	local plot = plots[plotId]
	local preset = Constants.GYM_COLORS[presetIndex] or Constants.GYM_COLORS[DEFAULT_COLOR]
	if not plot or not preset then
		return
	end
	-- keep walls dark like a real gym: tint the preset wall color toward black
	local wall = preset.Wall:Lerp(Color3.fromRGB(14, 14, 16), 0.45)
	local dim = preset.Accent:Lerp(Color3.fromRGB(40, 44, 52), 0.55)
	for _, p in ipairs(plot.Roles.Wall) do
		p.Color = wall
	end
	for _, p in ipairs(plot.Roles.Accent) do
		p.Color = preset.Accent
	end
	for _, p in ipairs(plot.Roles.AccentDim) do
		p.Color = dim
	end
	plot.Model:SetAttribute("AccentColor", preset.Accent)
end

-- Lights up the first `unlockedCount` stations' floor pads, dims the rest.
function PlotService.RefreshSlots(plotId, unlockedCount)
	local plot = plots[plotId]
	if not plot then
		return
	end
	plot.Unlocked = unlockedCount
	for k = 1, Constants.RACK_SLOT_MAX do
		local station = plot.Stations[k]
		if station then
			local open = k <= unlockedCount
			local color = open and OPEN_COLOR or LOCKED_COLOR
			local pad = station:FindFirstChild("Pad")
			if pad then
				pad.Color = color
				pad.Material = open and Enum.Material.Neon or Enum.Material.SmoothPlastic
				pad.Transparency = open and 0.35 or 0.2
				local tag = lockTag(pad)
				tag.Enabled = plot.OwnerUserId ~= 0
				tag.Label.Text = open and PlotService.StationName(station) or "LOCKED — upgrade Rack Slots"
				tag.Label.TextColor3 = open and Color3.fromRGB(190, 255, 215) or Color3.fromRGB(255, 150, 150)
			end
			local outline = station:FindFirstChild("Outline")
			if outline then
				for _, e in ipairs(outline:GetChildren()) do
					if e:IsA("BasePart") then
						e.Color = color
						e.Material = open and Enum.Material.Neon or Enum.Material.SmoothPlastic
					end
				end
			end
		end
	end
end

function PlotService.GetSlotPart(plotId, k)
	local station = PlotService.GetStation(plotId, k)
	return station and station:FindFirstChild("Pad") or nil
end

function PlotService.FindOpenSlot(plotId)
	local plot = plots[plotId]
	if not plot then
		return nil
	end
	for k = 1, plot.Unlocked do
		if not plot.Slots[k] and plot.Stations[k] then
			return k
		end
	end
	return nil
end

function PlotService.CountPlaced(plotId)
	local plot = plots[plotId]
	if not plot then
		return 0
	end
	local n = 0
	for _ in pairs(plot.Slots) do
		n += 1
	end
	return n
end

-- ----------------------------------------------------------------------
function PlotService.TeleportToPlot(player, plot)
	local character = player.Character
	local spawnPart = plot and plot.Model:FindFirstChild("PlotSpawn")
	if not character or not spawnPart then
		return
	end
	if not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	-- face out the front door toward the red carpet
	local from = spawnPart.Position + Vector3.new(0, 1, 0)
	local lookAt = Vector3.new(0, from.Y, from.Z)
	character:PivotTo(CFrame.lookAt(from, lookAt))
end

function PlotService.GetOwnerPlayer(plot)
	if not plot or plot.OwnerUserId == 0 then
		return nil
	end
	return Players:GetPlayerByUserId(plot.OwnerUserId)
end

return PlotService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="33">
      <Properties>
        <string name="Name">DefenseService</string>
        <string name="Source"><![CDATA[--[[
	DefenseService
	One Front Desk Worker per gym (a real R15 humanoid in a staff shirt). When
	someone lures an influencer out of that gym, the worker runs after the thief
	ANYWHERE on the map, pathfinding around walls. On catch: the influencer
	walks back to its machine and the thief is knocked down and stunned.

	Worker speed = Constants.EQUIPMENT.DeskSpeed.Values[owner's DeskSpeed level]

	States: Idle -> Chase -> Return -> Idle
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local SSS = game:GetService("ServerScriptService")

local Constants = require(RS.Modules.Constants)
local PlayerDataService = require(SSS.PlayerDataService)
local PlotService = require(SSS.PlotService)
local InfluencerService = require(SSS.InfluencerService)
local NpcService = require(SSS.NpcService)
local Notify = require(SSS.Notify)

local DefenseService = {}

local workers = {} -- [plotId] = worker record

-- ----------------------------------------------------------------------
local function homeCFrame(plot)
	local spawnPart = plot.Model:FindFirstChild("DeskSpawn")
	local desk = plot.Model:FindFirstChild("FrontDesk")
	local pos = spawnPart and spawnPart.Position or plot.Model:GetPivot().Position
	local face = desk and Vector3.new(desk.Position.X, pos.Y, desk.Position.Z) or pos + Vector3.new(0, 0, -1)
	return CFrame.lookAt(pos, face)
end

local function buildWorker(plot)
	local model = NpcService.CreateRig({
		Name = "FrontDeskWorker",
		Skin = Constants.SKIN_TONES[(plot.Id % #Constants.SKIN_TONES) + 1],
		Shirt = Color3.fromRGB(220, 50, 55),
		Pants = Color3.fromRGB(30, 30, 34),
	})
	local head = model:FindFirstChild("Head") or model.PrimaryPart

	local tag = Instance.new("BillboardGui")
	tag.Name = "Tag"
	tag.Size = UDim2.new(0, 150, 0, 28)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 80
	tag.LightInfluence = 0
	tag.Parent = head

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = "FRONT DESK"
	label.Parent = tag

	local home = homeCFrame(plot)
	model:PivotTo(home + Vector3.new(0, 0.5, 0))
	model.Parent = plot.Model
	NpcService.Activate(model)

	local w = {
		Plot = plot,
		Model = model,
		Root = model:FindFirstChild("HumanoidRootPart"),
		Label = label,
		Home = home,
		State = "Idle",
		Thefts = {}, -- list of { Rec = rec, ThiefUserId = id }
	}
	workers[plot.Id] = w
	return w
end

local function deskSpeed(plot)
	local owner = PlotService.GetOwnerPlayer(plot)
	local profile = owner and PlayerDataService.GetProfile(owner.UserId)
	local level = profile and profile.Equipment.DeskSpeed or 1
	return Constants.EQUIPMENT.DeskSpeed.Values[level] or Constants.EQUIPMENT.DeskSpeed.Values[1]
end

local function setLabel(w, text, color)
	w.Label.Text = text
	w.Label.TextColor3 = color or Color3.new(1, 1, 1)
end

local function goHome(w)
	w.State = "Return"
	setLabel(w, "FRONT DESK")
	NpcService.WalkTo(w.Model, w.Home.Position, Constants.DEFENSE.ReturnHomeSpeed, function()
		if w.State == "Return" then
			w.State = "Idle"
			w.Model:PivotTo(w.Home)
		end
	end, 40, function()
		w.State = "Idle"
		w.Model:PivotTo(w.Home)
	end)
end

-- ----------------------------------------------------------------------
-- Stun / knockdown
-- ----------------------------------------------------------------------
local function knockDown(player, fromPos)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then
		return
	end
	player:SetAttribute("Stunned", true)
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.PlatformStand = true
	-- shove away from the worker so it reads as a tackle
	local away = (hrp.Position - fromPos) * Vector3.new(1, 0, 1)
	away = away.Magnitude > 0.1 and away.Unit or -hrp.CFrame.LookVector
	hrp.AssemblyLinearVelocity = away * 28 + Vector3.new(0, 18, 0)

	task.delay(Constants.DEFENSE.StunSeconds, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid.WalkSpeed = Constants.NORMAL_WALKSPEED
			humanoid.JumpPower = 50
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		player:SetAttribute("Stunned", false)
	end)
end

-- ----------------------------------------------------------------------
-- Theft hooks (called from InfluencerService)
-- ----------------------------------------------------------------------
local function onTheftStarted(rec, thief, victimPlot)
	local w = workers[victimPlot.Id]
	if not w then
		return
	end
	table.insert(w.Thefts, { Rec = rec, ThiefUserId = thief.UserId })
	w.State = "Chase"
	setLabel(w, "STOP! THIEF!", Color3.fromRGB(255, 90, 90))
	NpcService.Chase(w.Model, thief, deskSpeed(victimPlot))
end

local function onTheftEnded(rec, victimPlot)
	local w = workers[victimPlot.Id]
	if not w then
		return
	end
	for i = #w.Thefts, 1, -1 do
		if w.Thefts[i].Rec == rec then
			table.remove(w.Thefts, i)
		end
	end
	if #w.Thefts == 0 and w.State == "Chase" then
		goHome(w)
	end
end

-- ----------------------------------------------------------------------
-- Heartbeat
-- ----------------------------------------------------------------------
local function currentTarget(w)
	for i = #w.Thefts, 1, -1 do
		local t = w.Thefts[i]
		local stillStolen = t.Rec.Model and t.Rec.State == "Following" and t.Rec.CarrierUserId == t.ThiefUserId
		if not stillStolen then
			table.remove(w.Thefts, i)
		end
	end
	return w.Thefts[1]
end

local accum = 0
local function step(dt)
	accum += dt
	if accum < 0.1 then
		return
	end
	accum = 0
	for _, w in pairs(workers) do
		if w.State == "Chase" then
			local t = currentTarget(w)
			if not t then
				goHome(w)
			else
				local thief = Players:GetPlayerByUserId(t.ThiefUserId)
				local character = thief and thief.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if hrp then
					-- keep chasing the current thief at the current desk speed
					NpcService.Chase(w.Model, thief, deskSpeed(w.Plot))
					local d = (hrp.Position - w.Root.Position) * Vector3.new(1, 0, 1)
					if d.Magnitude <= Constants.DEFENSE.CatchRadius then
						-- CAUGHT
						local rec = t.Rec
						InfluencerService.ReturnToOrigin(rec) -- fires onTheftEnded
						knockDown(thief, w.Root.Position)
						Notify(thief, "The Front Desk caught you! " .. rec.Name .. " is heading back.", "fail")
						local owner = PlotService.GetOwnerPlayer(w.Plot)
						if owner then
							Notify(owner, "Your Front Desk caught " .. thief.DisplayName .. " and saved " .. rec.Name .. "!", "success")
						end
					end
				end
			end
		end
	end
end

-- ----------------------------------------------------------------------
function DefenseService.Init()
	for _, plot in pairs(PlotService.GetAllPlots()) do
		buildWorker(plot)
	end
	InfluencerService.OnTheftStarted = onTheftStarted
	InfluencerService.OnTheftEnded = onTheftEnded
	RunService.Heartbeat:Connect(step)
end

-- Called when a plot is released (owner left)
function DefenseService.ResetPlot(plot)
	local w = workers[plot.Id]
	if not w then
		return
	end
	w.Thefts = {}
	w.State = "Idle"
	setLabel(w, "FRONT DESK")
	NpcService.Stop(w.Model)
	w.Model:PivotTo(w.Home)
end

return DefenseService
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="34">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="35">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="36">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">GymAnimator</string>
          <string name="Source"><![CDATA[--[[
	GymAnimator (client)
	Brings the gyms to life locally:
	  - Influencers sitting on a machine are posed every frame by the procedural
	    exercise library (RigSolver + Exercises). Time comes from
	    workspace:GetServerTimeNow(), so every player sees the same rep.
	  - Machine parts (bars, weight stacks, cables, pedals, treadmill belts)
	    move with the athlete.
	  - When an athlete hops on, the pose blends in from how they were standing.
	  - The conveyor's chevrons scroll so the belt visibly runs.
	  - Your own placed influencers don't show a "Steal" prompt to you.
	  - [X] lets go of the influencer following you.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local Modules = RS:WaitForChild("Modules")
local GymModules = Modules:WaitForChild("Gym")
local Constants = require(Modules:WaitForChild("Constants"))
local RigSolver = require(GymModules:WaitForChild("RigSolver"))
local Exercises = require(GymModules:WaitForChild("Exercises"))
local Specs = require(GymModules:WaitForChild("StationSpecs"))
local Remotes = RS:WaitForChild("Remotes")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local ANIM_RANGE = 230 -- only animate athletes this close to the camera
local BLEND_TIME = 0.9

local influencers = workspace:WaitForChild("Influencers", 30)
local mapFolder = workspace:WaitForChild("GymWarsMap")

local bulkParts, bulkCFs = {}, {}
local function queue(part, cf)
	local n = #bulkParts + 1
	bulkParts[n] = part
	bulkCFs[n] = cf
end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function axisCF(a, b)
	local mid = (a + b) / 2
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local z = dir:Cross(up).Unit
	return CFrame.fromMatrix(mid, dir, z:Cross(dir).Unit, z)
end

-- ----------------------------------------------------------------------
-- Station contexts (rest poses of every moving part, captured once)
-- ----------------------------------------------------------------------
local stationCtx = {}

local function buildCtx(station)
	local base = station:FindFirstChild("Base")
	local kind = station:GetAttribute("Exercise")
	if not base or not kind then
		return nil
	end
	local ctx = {
		Station = station,
		Kind = kind,
		Base = base.CFrame,
		Spec = Specs[kind],
		RestLocal = {},
		Groups = {},
		Cables = {},
	}
	local moving = station:FindFirstChild("Moving")
	if moving then
		for _, m in ipairs(moving:GetChildren()) do
			local prim = m:IsA("Model") and (m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart"))
			if prim then
				local primRest = prim.CFrame
				ctx.RestLocal[m.Name] = ctx.Base:ToObjectSpace(primRest)
				local g = { Parts = {}, Rel = {}, Rest = {} }
				for _, p in ipairs(m:GetDescendants()) do
					if p:IsA("BasePart") then
						table.insert(g.Parts, p)
						table.insert(g.Rel, primRest:ToObjectSpace(p.CFrame))
						table.insert(g.Rest, p.CFrame)
					end
				end
				ctx.Groups[m.Name] = g
			end
		end
	end
	local cables = station:FindFirstChild("Cables")
	if cables then
		for _, c in ipairs(cables:GetChildren()) do
			if c:IsA("BasePart") then
				ctx.Cables[c.Name] = { Part = c, RestCF = c.CFrame, RestSize = c.Size }
			end
		end
	end
	stationCtx[station] = ctx
	return ctx
end

local function getCtx(station)
	return stationCtx[station] or buildCtx(station)
end

local function applyEquipment(ctx, e)
	for name, cf in pairs(e.Moves) do
		local g = ctx.Groups[name]
		if g then
			for i, p in ipairs(g.Parts) do
				queue(p, cf * g.Rel[i])
			end
		end
	end
	for name, ab in pairs(e.Cables) do
		local c = ctx.Cables[name]
		if c then
			local len = (ab[2] - ab[1]).Magnitude
			if len > 0.05 then
				c.Part.Size = Vector3.new(len, c.RestSize.Y, c.RestSize.Z)
				queue(c.Part, axisCF(ab[1], ab[2]))
			end
		end
	end
end

local function restoreEquipment(ctx)
	for _, g in pairs(ctx.Groups) do
		for i, p in ipairs(g.Parts) do
			queue(p, g.Rest[i])
		end
	end
	for _, c in pairs(ctx.Cables) do
		c.Part.Size = c.RestSize
		queue(c.Part, c.RestCF)
	end
end

-- ----------------------------------------------------------------------
-- Athletes
-- ----------------------------------------------------------------------
local active = {} -- [model] = state
local lastPelvis = {} -- [model] = LowerTorso CFrame while walking (for blend-in)
local warned = {}

local function activate(model, station)
	local ctx = getCtx(station)
	if not ctx then
		return nil
	end
	local ok, rig = pcall(RigSolver.new, model)
	if not ok then
		return nil -- rig still streaming in; try again next frame
	end
	return {
		Model = model,
		Rig = rig,
		Ctx = ctx,
		Station = station,
		SeatedAt = model:GetAttribute("SeatedAt"),
		P = Exercises.Params(model:GetAttribute("Seed") or 1),
		StartClock = os.clock(),
		StartPelvis = lastPelvis[model],
	}
end

local function deactivate(a)
	if a.Ctx then
		restoreEquipment(a.Ctx)
	end
	if a.Rig and a.Model.Parent then
		a.Rig:reset()
		pcall(function()
			a.Rig:apply()
		end)
	end
end

local function animate(a, now)
	local rig = a.Rig
	rig:reset()
	rig:setRootCFrame(nil)
	local t = now - (a.SeatedAt or now)
	local fn = Exercises[a.Ctx.Kind] or Exercises.Idle
	local ok, e = pcall(fn, rig, a.Ctx, math.max(t, 0), a.P)
	if not ok then
		if not warned[a.Ctx.Kind] then
			warned[a.Ctx.Kind] = true
			warn("[GymAnimator] " .. tostring(a.Ctx.Kind) .. ": " .. tostring(e))
		end
		return
	end

	local k = (os.clock() - a.StartClock) / BLEND_TIME
	if k < 1 and a.StartPelvis then
		if not a.Snap then
			a.Snap = {}
			for name in pairs(rig.T) do
				a.Snap[name] = CFrame.new()
			end
			local j = rig.J.Root
			local hrpCF = rig.Parts.HumanoidRootPart.CFrame
			a.Snap.Root = (hrpCF * j.C0):Inverse() * a.StartPelvis * j.C1
		end
		rig:blendFrom(a.Snap, smooth(k))
	end
	rig:apply()
	applyEquipment(a.Ctx, e)
end

-- ----------------------------------------------------------------------
-- Conveyor chevrons
-- ----------------------------------------------------------------------
local chevrons = {}
local chevSpacing = 8
do
	local belt = mapFolder:WaitForChild("Belt", 10)
	local folder = belt and belt:FindFirstChild("Chevrons")
	if folder then
		chevSpacing = folder:GetAttribute("Spacing") or chevSpacing
		for _, m in ipairs(folder:GetChildren()) do
			for _, p in ipairs(m:GetDescendants()) do
				if p:IsA("BasePart") then
					table.insert(chevrons, { Part = p, Rest = p.CFrame })
				end
			end
		end
	end
end

-- ----------------------------------------------------------------------
-- Main loop (PreSimulation runs after the Animator, so our joint transforms win)
-- ----------------------------------------------------------------------
local promptAccum = 0

RunService.PreSimulation:Connect(function(dt)
	table.clear(bulkParts)
	table.clear(bulkCFs)
	local now = workspace:GetServerTimeNow()
	local camPos = camera.CFrame.Position

	-- belt
	local speed = workspace:GetAttribute("BeltSpeed") or Constants.BELT.Speed
	local off = (now * speed) % chevSpacing
	local dir = Vector3.new(0, 0, off)
	for _, c in ipairs(chevrons) do
		queue(c.Part, c.Rest + dir)
	end

	promptAccum += dt
	local doPrompts = promptAccum > 0.3
	if doPrompts then
		promptAccum = 0
	end

	if influencers then
		for _, model in ipairs(influencers:GetChildren()) do
			local state = model:GetAttribute("State")
			local ref = model:FindFirstChild("Station")
			local station = ref and ref.Value
			local a = active[model]
			if state == "Placed" and station then
				local seatedAt = model:GetAttribute("SeatedAt")
				if a and (a.Station ~= station or a.SeatedAt ~= seatedAt) then
					deactivate(a)
					a = nil
					active[model] = nil
				end
				if not a then
					a = activate(model, station)
					active[model] = a
				end
				local hrp = model:FindFirstChild("HumanoidRootPart")
				if a and hrp and (hrp.Position - camPos).Magnitude < ANIM_RANGE then
					animate(a, now)
				end
				if doPrompts then
					local prompt = hrp and hrp:FindFirstChild("GrabPrompt")
					if prompt then
						local mine = model:GetAttribute("OwnerUserId") == player.UserId
						if mine and prompt.Enabled then
							prompt.Enabled = false
						end
					end
				end
			else
				if a then
					deactivate(a)
					active[model] = nil
				end
				local lt = model:FindFirstChild("LowerTorso")
				if lt then
					lastPelvis[model] = lt.CFrame
				end
			end
		end
	end

	if #bulkParts > 0 then
		workspace:BulkMoveTo(bulkParts, bulkCFs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end)

if influencers then
	influencers.ChildRemoved:Connect(function(model)
		local a = active[model]
		active[model] = nil
		lastPelvis[model] = nil
		if a and a.Ctx then
			table.clear(bulkParts)
			table.clear(bulkCFs)
			restoreEquipment(a.Ctx)
			workspace:BulkMoveTo(bulkParts, bulkCFs, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

-- [X] = let go of whoever is following you
UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.X and (player:GetAttribute("Carrying") or "") ~= "" then
		Remotes.DismissFollower:FireServer()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">GymWarsClient</string>
          <string name="Source"><![CDATA[--[[
	GYM WARS — client UI
	HUD, Shop (Clothing / Equipment / Boosters), Rebirth panel, Gym color picker,
	toasts. Everything is built in code (no external assets) and reads state
	from leaderstats + player attributes that the server keeps in sync.
	The client never changes game state itself — it only asks the server.
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local Constants = require(RS:WaitForChild("Modules"):WaitForChild("Constants"))
local Remotes = RS:WaitForChild("Remotes")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ======================================================================
-- Style
-- ======================================================================
local PANEL = Color3.fromRGB(20, 22, 30)
local PANEL_2 = Color3.fromRGB(30, 33, 44)
local TEXT = Color3.fromRGB(240, 242, 248)
local SUB = Color3.fromRGB(150, 158, 175)
local GOLD = Color3.fromRGB(244, 201, 58)
local GREEN = Color3.fromRGB(90, 220, 120)
local RED = Color3.fromRGB(230, 80, 70)
local BLUE = Color3.fromRGB(79, 157, 251)
local PURPLE = Color3.fromRGB(176, 107, 240)
local LOCKED = Color3.fromRGB(70, 74, 88)

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 10)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(60, 64, 80)
	s.Thickness = thickness or 1.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = props.Font or Enum.Font.GothamBold
	l.TextSize = props.TextSize or 14
	l.TextColor3 = props.Color or TEXT
	l.TextXAlignment = props.XAlign or Enum.TextXAlignment.Left
	l.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	l.TextWrapped = props.Wrapped or false
	l.RichText = props.Rich or false
	l.Size = props.Size or UDim2.new(1, 0, 0, 20)
	l.Position = props.Position or UDim2.new(0, 0, 0, 0)
	l.Text = props.Text or ""
	l.Name = props.Name or "Label"
	l.Parent = parent
	return l
end

local function button(parent, props)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BackgroundColor3 = props.Color or GREEN
	b.Font = Enum.Font.GothamBlack
	b.TextSize = props.TextSize or 14
	b.TextColor3 = props.TextColor or Color3.fromRGB(15, 15, 20)
	b.Size = props.Size or UDim2.new(0, 100, 0, 34)
	b.Position = props.Position or UDim2.new(0, 0, 0, 0)
	b.AnchorPoint = props.Anchor or Vector2.new(0, 0)
	b.Text = props.Text or ""
	b.Name = props.Name or "Button"
	b.Parent = parent
	corner(b, props.Radius or 8)
	return b
end

local function decode(attr, fallback)
	local raw = player:GetAttribute(attr)
	if type(raw) ~= "string" or raw == "" then
		return fallback
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(data) == "table" then
		return data
	end
	return fallback
end

local fmt = Constants.FormatNumber

-- ======================================================================
-- Root
-- ======================================================================
local gui = Instance.new("ScreenGui")
gui.Name = "GymWarsUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

-- ======================================================================
-- Stats panel (top-left)
-- ======================================================================
local stats = Instance.new("Frame")
stats.Name = "Stats"
stats.Size = UDim2.new(0, 250, 0, 150)
stats.Position = UDim2.new(0, 14, 0, 14)
stats.BackgroundColor3 = PANEL
stats.BackgroundTransparency = 0.08
stats.Parent = gui
corner(stats, 12)
stroke(stats)

local cashLabel = label(stats, {
	Name = "Cash",
	Font = Enum.Font.GothamBlack,
	TextSize = 26,
	Color = GREEN,
	Size = UDim2.new(1, -24, 0, 32),
	Position = UDim2.new(0, 12, 0, 8),
	Text = "$0",
})
local incomeLabel = label(stats, {
	Name = "Income",
	TextSize = 13,
	Color = SUB,
	Size = UDim2.new(1, -24, 0, 18),
	Position = UDim2.new(0, 12, 0, 40),
	Text = "+$0/s",
})
local strengthLabel = label(stats, {
	Name = "Strength",
	TextSize = 16,
	Color = TEXT,
	Size = UDim2.new(1, -24, 0, 20),
	Position = UDim2.new(0, 12, 0, 64),
	Text = "Strength: 0",
})
local rebirthLabel = label(stats, {
	Name = "Rebirths",
	TextSize = 14,
	Color = PURPLE,
	Size = UDim2.new(1, -24, 0, 18),
	Position = UDim2.new(0, 12, 0, 88),
	Text = "Rebirths: 0",
})
local rackLabel = label(stats, {
	Name = "Rack",
	TextSize = 14,
	Color = BLUE,
	Size = UDim2.new(1, -24, 0, 18),
	Position = UDim2.new(0, 12, 0, 110),
	Text = "Machines: 0/4",
})

-- Booster timers (under stats)
local boosterBar = Instance.new("Frame")
boosterBar.Name = "Boosters"
boosterBar.Size = UDim2.new(0, 250, 0, 0)
boosterBar.AutomaticSize = Enum.AutomaticSize.Y
boosterBar.Position = UDim2.new(0, 14, 0, 172)
boosterBar.BackgroundTransparency = 1
boosterBar.Parent = gui
local boosterLayout = Instance.new("UIListLayout")
boosterLayout.Padding = UDim.new(0, 6)
boosterLayout.Parent = boosterBar

-- Carrying banner (top-center)
local carryBanner = label(gui, {
	Name = "Carrying",
	Font = Enum.Font.GothamBlack,
	TextSize = 20,
	Color = GOLD,
	XAlign = Enum.TextXAlignment.Center,
	Size = UDim2.new(0, 520, 0, 30),
	Position = UDim2.new(0.5, -260, 0, 14),
	Text = "",
})
carryBanner.TextStrokeTransparency = 0.4

local stunBanner = label(gui, {
	Name = "Stunned",
	Font = Enum.Font.GothamBlack,
	TextSize = 34,
	Color = RED,
	XAlign = Enum.TextXAlignment.Center,
	Size = UDim2.new(0, 520, 0, 40),
	Position = UDim2.new(0.5, -260, 0.35, 0),
	Text = "",
})
stunBanner.TextStrokeTransparency = 0.3

